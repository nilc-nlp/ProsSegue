            text = "" 
        intervals [14]:
            xmin = 50.51083 
            xmax = 52.26 
            text = "e eu queria era uma fuga" 
        intervals [15]:
            xmin = 52.26 
            xmax = 58.2 
            text = "então a minha fuga era me deitar na cama ligar o receptor e ficar vendo" 
