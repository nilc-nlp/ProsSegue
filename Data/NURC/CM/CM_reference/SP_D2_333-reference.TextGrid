            xmax = 211.55004 
            text = "" 
        intervals [45]:
            xmin = 211.55004 
            xmax = 218.11955 
            text = "e e e que como isso constitui numa pedra no caminho quando é passado em termos de arte cênica" 
        intervals [46]:
