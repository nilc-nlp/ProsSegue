            text = "hã" 
        intervals [2726]:
            xmin = 3280.116407333317 
            xmax = 3280.7362508440165 
            text = "..." 
        intervals [2727]:
            xmin = 3280.7362508440165 
            xmax = 3285.054320342923 
            text = "parece que no Brasil é um dos lugares em que o nosso cinema é de mais baixo custo" 
        intervals [2728]:
            xmin = 3285.054320342923 
            xmax = 3285.4560208333332 
            text = "não é?" 
        intervals [2729]:
            xmin = 3285.4560208333332 
            xmax = 3285.87893897959 
            text = "..." 
        intervals [2730]:
            xmin = 3285.87893897959 
            xmax = 3287.3864931598155 
            text = "é um cinema que não é" 
        intervals [2731]:
            xmin = 3287.3864931598155 
            xmax = 3287.7511069896386 
            text = "..." 
        intervals [2732]:
            xmin = 3287.7511069896386 
            xmax = 3288.748583333333 
            text = "MUIto oneroso" 
        intervals [2733]:
            xmin = 3288.748583333333 
            xmax = 3289.6054287527395 
            text = "assim mesmo" 
        intervals [2734]:
            xmin = 3289.6054287527395 
