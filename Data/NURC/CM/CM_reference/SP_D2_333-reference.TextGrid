        intervals [41]:
            xmin = 169.52 
            xmax = 187.00412 
            text = "é e agora como o que domina o mercado é a globo e os estúdios da globo estão no no rio isto faz com que até os paulistas que vão para o rio os artistas paulistas que estão lá eles começam a adotar para não ficar diferente" 
        intervals [42]:
            xmin = 187.00412 
            xmax = 187.47481 
            text = "" 
        intervals [43]:
            xmin = 187.47481 
            xmax = 211.22737 
            text = "e uma vez que nós estamos aqui dando um depoimento sobre esse aspecto de linguagem eu já enfoquei na nas minhas crônicas da folha a pedra no caminho que é a a pronúncia tão diferente e mesmo a maneira de falar as singularidades que tem cada região do país" 
        intervals [44]:
