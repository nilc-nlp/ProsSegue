        intervals [4]:
            xmin = 16.37625 
            xmax = 27.300041666666665 
            text = "o que me parece é que na ocasião quando ele me incumbiu disso ele pensou que ele ia ficar em face de uma recusa e que eu ia esnobar" 
        intervals [5]:
            xmin = 27.300041666666665 
            xmax = 32.414010705008565 
            text = "agora vamos usar um termo que eu uso bastante e que todo mundo usa muito" 
