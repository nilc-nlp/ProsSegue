    item [10]:
        class = "IntervalTier" 
        name = "TB-L2-normal" 
        xmin = 0 
        xmax = 3310.92 
        intervals: size = 458 
        intervals [1]:
            xmin = 0 
            xmax = 84.44296 
            text = "" 
        intervals [2]:
            xmin = 84.44296 
            xmax = 93.40465 
            text = "eu estava na tupi trabalhando como como funcionária da tupi da rádio tupi quando foi lançada a primeira primeira televisão" 
        intervals [3]:
            xmin = 93.40465 
            xmax = 94.24323 
            text = "" 
        intervals [4]:
            xmin = 94.24323 
            xmax = 97.03606 
            text = "de modo que eu vi nascer propriamente a t a televisão" 
        intervals [5]:
            xmin = 97.03606 
            xmax = 97.21448 
            text = "" 
        intervals [6]:
            xmin = 97.21448 
            xmax = 97.44721 
            text = "é" 
        intervals [7]:
            xmin = 97.44721 
            xmax = 102.05502 
            text = "eu eu eu vi nascer eu estava lá ah todo momento né" 
        intervals [8]:
            xmin = 102.05502 
            xmax = 102.89293 
            text = "" 
        intervals [9]:
            xmin = 102.89293 
            xmax = 113.93526 
            text = "e uma coisa que eu gostaria de lembrar a você justamente a respeito de linguagem é o seguinte que eu noto que muito paulista fica um pouco chocado com a linguajar carioca" 
        intervals [10]:
            xmin = 113.93526 
            xmax = 114.44472 
            text = "" 
        intervals [11]:
            xmin = 114.44472 
            xmax = 116.47628 
            text = "com os esses e os erres do carioca" 
        intervals [12]:
            xmin = 116.47628 
            xmax = 116.68 
            text = "" 
        intervals [13]:
            xmin = 116.68 
            xmax = 130.96465 
            text = "que eram justamente um dos um dos defeitos muito grandes do rádio daquele tempo que era quando um um locutor ia fazer um teste o o chefe dizia a ele diga aí os efe os esses e os erres" 
        intervals [14]:
            xmin = 130.96465 
            xmax = 131.15522 
            text = "" 
        intervals [15]:
            xmin = 131.15522 
            xmax = 132.02871 
            text = "esse era o teste" 
        intervals [16]:
            xmin = 132.02871 
            xmax = 132.92092 
            text = "" 
        intervals [17]:
            xmin = 132.92092 
            xmax = 136.7905 
            text = "para saber se ele tinha ah boa dicção para falar em rádio não é" 
        intervals [18]:
            xmin = 136.7905 
            xmax = 138.08868 
            text = "então ele caprichava" 
        intervals [19]:
            xmin = 138.08868 
            xmax = 138.27269 
            text = "" 
        intervals [20]:
            xmin = 138.27269 
            xmax = 144.97522 
            text = "é isso que o chico anísio está ah ah ah caçoando na no programa dele do chico anísio não é" 
        intervals [21]:
            xmin = 144.97522 
            xmax = 145.12108 
            text = "" 
        intervals [22]:
            xmin = 145.12108 
            xmax = 150.73752 
            text = "ele ca eh eh ele insiste dorme em cima dos esses e dos erres né" 
        intervals [23]:
            xmin = 150.73752 
            xmax = 151.67536 
            text = "" 
        intervals [24]:
            xmin = 151.67536 
            xmax = 167.42242 
            text = "e mas eu eu noto que agora sobretudo na nossa família que nós temos muita preocupação da da linguagem simples e da linguagem correta é exata nós ficamos um pouco chocados com o esse e o erre exagerados dos cariocas" 
        intervals [25]:
            xmin = 167.42242 
            xmax = 169.36128 
            text = "que são mesmo um preciosismo inútil né" 
        intervals [26]:
            xmin = 169.36128 
            xmax = 181.99873 
            text = "" 
        intervals [27]:
            xmin = 181.99873 
            xmax = 182.48781 
            text = "adotam" 
        intervals [28]:
            xmin = 182.48781 
            xmax = 247.45635 
            text = "" 
        intervals [29]:
            xmin = 247.45635 
            xmax = 248.45163 
            text = "é artificial" 
        intervals [30]:
            xmin = 248.45163 
            xmax = 288.76008 
            text = "" 
        intervals [31]:
            xmin = 288.76008 
            xmax = 289.95837 
            text = "ela nunca morou aqui não é" 
        intervals [32]:
            xmin = 289.95837 
            xmax = 290.66633 
            text = "" 
        intervals [33]:
            xmin = 290.66633 
            xmax = 292.4 
            text = "maria fernanda nunca morou em são paulo" 
        intervals [34]:
            xmin = 292.4 
            xmax = 350.02161 
            text = "" 
        intervals [35]:
            xmin = 350.02161 
            xmax = 351.44481 
            text = "mas isso é um pouco utópico helena" 
        intervals [36]:
            xmin = 351.44481 
            xmax = 366.88923 
            text = "você veja outros países por exemplo como têm ah na itália na frança e e quase às vezes não se na espanha a a há dialetos que quase não se não se entende o o pelos outros" 
        intervals [37]:
            xmin = 366.88923 
            xmax = 367.96244 
            text = "" 
        intervals [38]:
            xmin = 367.96244 
            xmax = 369.48 
            text = "é muito difícil isso" 
        intervals [39]:
            xmin = 369.48 
            xmax = 381.56 
            text = "" 
        intervals [40]:
            xmin = 381.56 
            xmax = 382.76 
            text = "eles eles se ironizam hein" 
        intervals [41]:
            xmin = 382.76 
            xmax = 406.43736 
            text = "" 
        intervals [42]:
            xmin = 406.43736 
            xmax = 407.60901 
            text = "mas helena nós" 
        intervals [43]:
            xmin = 407.60901 
            xmax = 408.13853 
            text = "" 
        intervals [44]:
            xmin = 408.13853 
            xmax = 413.75092 
            text = "helena nós estamos num país em que durante alguns anos não houve prova de redação de português" 
        intervals [45]:
            xmin = 413.75092 
            xmax = 415.32588 
            text = "o o que você quer mais depois disto" 
        intervals [46]:
            xmin = 415.32588 
            xmax = 415.7844 
            text = "" 
        intervals [47]:
            xmin = 415.7844 
            xmax = 416.7813598397959 
            text = "quer dizer não há codificação" 
        intervals [48]:
            xmin = 416.7813598397959 
            xmax = 419.97408 
            text = "como é que não há codi não pode haver uma codificação num país assim não é" 
        intervals [49]:
            xmin = 419.97408 
            xmax = 429.91826 
            text = "" 
        intervals [50]:
            xmin = 429.91826 
            xmax = 430.44336 
            text = "cursou" 
        intervals [51]:
            xmin = 430.44336 
            xmax = 432.8424 
            text = "juca de oliveira araci" 
        intervals [52]:
            xmin = 432.8424 
            xmax = 437.74607 
            text = "" 
        intervals [53]:
            xmin = 437.74607 
            xmax = 438.65965 
            text = "fala por exemplos" 
        intervals [54]:
            xmin = 438.65965 
            xmax = 440.70151 
            text = "" 
        intervals [55]:
            xmin = 440.70151 
            xmax = 442.01115 
            text = "mas ela faz o curso aqui" 
        intervals [56]:
            xmin = 442.01115 
            xmax = 452.06585 
            text = "" 
        intervals [57]:
            xmin = 452.06585 
            xmax = 453.5088 
            text = "mas ele carrega" 
        intervals [58]:
            xmin = 453.5088 
            xmax = 454.68707 
            text = "mas é vô voluntária né" 
        intervals [59]:
            xmin = 454.68707 
            xmax = 518.15731 
            text = "" 
        intervals [60]:
            xmin = 518.15731 
            xmax = 533.3858497921099 
            text = "eu acho helena mas eu acho também eu fico revoltada com a influência excessiva por exemplo do cinema da história em quadrinhos histórias que não têm nada que ver com nós mas absolutamente nada que ver com a nossa formação com a nossa história com a" 
        intervals [61]:
            xmin = 533.3858497921099 
            xmax = 533.9292708333334 
            text = "" 
        intervals [62]:
            xmin = 533.9292708333334 
