            text = "hã" 
        intervals [2736]:
            xmin = 3290.9602916666663 
            xmax = 3293.0784349635396 
            text = "diante do poder aquisitivo da população" 
        intervals [2737]:
            xmin = 3293.0784349635396 
            xmax = 3293.5480624999996 
            text = "..." 
        intervals [2738]:
            xmin = 3293.5480624999996 
            xmax = 3294.937833333333 
            text = "é bastante oneroso" 
        intervals [2739]:
            xmin = 3294.937833333333 
