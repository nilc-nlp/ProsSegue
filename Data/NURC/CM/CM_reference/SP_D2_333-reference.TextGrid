        intervals [2]:
            xmin = 4.70344 
            xmax = 15.68396 
            text = "olha isa eu como você sabe uma pessoa um diretor lá da folha certa feita me chamou e me incumbiu de escrever sobre televisão" 
        intervals [3]:
            xmin = 15.68396 
            xmax = 16.37625 
