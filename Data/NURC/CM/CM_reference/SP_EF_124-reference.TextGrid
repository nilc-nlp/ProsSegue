            xmax = 487.0420634744954 
            text = "..." 
        intervals [120]:
            xmin = 487.0420634744954 
            xmax = 498.1588565939599 
            text = "hipótese de trabalho que eu acho um pouco infantil... é o fato... dos japoneses e chineses... estarem sempre sentados ou ajoelhados e verem as pessoas numa certa perspectiva" 
        intervals [121]:
            xmin = 498.1588565939599 
