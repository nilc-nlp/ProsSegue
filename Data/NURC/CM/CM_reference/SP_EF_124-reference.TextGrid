            text = "..." 
        intervals [159]:
            xmin = 708.1833681872157 
            xmax = 711.3112743893341 
            text = "que pode obedecer a variações mas há uma hisTÓria no mito" 
        intervals [160]:
            xmin = 711.3112743893341 
            xmax = 713.6732571689406 
            text = "..." 
        intervals [161]:
            xmin = 713.6732571689406 
            xmax = 720.8520979472013 
            text = "mas::... uma vez que se desenrolou este drama do mito... este drama não tem fim" 
        intervals [162]:
            xmin = 720.8520979472013 
            xmax = 723.3047356472374 
            text = "..." 
        intervals [163]:
            xmin = 723.3047356472374 
            xmax = 726.6776657789823 
            text = "porque ele se repete sempre ele é um presente eterno" 
        intervals [164]:
            xmin = 726.6776657789823 
            xmax = 727.3432575486682 
            text = "..." 
        intervals [165]:
            xmin = 727.3432575486682 
            xmax = 728.1397106232803 
            text = "--isto ficou claro?--" 
        intervals [166]:
            xmin = 728.1397106232803 
            xmax = 729.6462953233254 
            text = "..." 
        intervals [167]:
            xmin = 729.6462953233254 
            xmax = 743.5029711250577 
            text = "isto não é só característico dos hopi... é característico de todo grupo... que::... tenha (um conceito) da existência... baseado em mitos ou seja todo grupo humano praticamente" 
        intervals [168]:
            xmin = 743.5029711250577 
            xmax = 744.6717612807956 
            text = "..." 
        intervals [169]:
            xmin = 744.6717612807956 
            xmax = 757.7851729182406 
            text = "mas alguns... põem ÊNfase... neste eterno presente... em que... há forças... ocultas que de repente se manifestam" 
        intervals [170]:
            xmin = 757.7851729182406 
            xmax = 758.9971055575621 
            text = "..." 
        intervals [171]:
            xmin = 758.9971055575621 
            xmax = 772.6832892421994 
            text = "como diz... ahn Whorf... ''não se pode dizer que as coisas vão acontecer... que elas aconteceram... ou que elas acontecem agora" 
        intervals [172]:
            xmin = 772.6832892421994 
            xmax = 777.0380344461457 
            text = "as coisas sempre... se E-VEN-TU-AM''... (lembram-se disso?)" 
        intervals [173]:
            xmin = 777.0380344461457 
            xmax = 777.779054187223 
            text = "..." 
        intervals [174]:
            xmin = 777.779054187223 
            xmax = 782.4677602825298 
            text = "--eu procurei no Pequeno Dicionário... da Língua Portuguesa e não encontrei a palavra eventuar" 
        intervals [175]:
            xmin = 782.4677602825298 
            xmax = 784.6628053742679 
            text = "..." 
        intervals [176]:
            xmin = 784.6628053742679 
            xmax = 787.909919718625 
            text = "e em inglês é palavra raro eu vi lá termo raro" 
        intervals [177]:
            xmin = 787.909919718625 
            xmax = 790.2243521843737 
            text = "..." 
        intervals [178]:
            xmin = 790.2243521843737 
            xmax = 811.7885294521687 
            text = "mas ele diz para o hopi... a coisa... não surge à existência porque houve um passado que levou a certas... ah ações determinadas... há um presente... em que as coisas então são:: contemporâneas... e depois o futuro... certo?" 
        intervals [179]:
            xmin = 811.7885294521687 
            xmax = 812.600569334363 
            text = "..." 
        intervals [180]:
            xmin = 812.600569334363 
            xmax = 819.6072195668331 
            text = "há... um conjunto... de indícios que é necessário interpretar" 
        intervals [181]:
            xmin = 819.6072195668331 
            xmax = 820.9156137240219 
            text = "..." 
        intervals [182]:
            xmin = 820.9156137240219 
            xmax = 824.0147461097473 
            text = "de onde a importância da magia e da religião" 
        intervals [183]:
            xmin = 824.0147461097473 
            xmax = 825.0411375197076 
            text = "..." 
        intervals [184]:
            xmin = 825.0411375197076 
            xmax = 833.8541127882966 
            text = "e esses indícios mostram que de repente... uma força... num determinado momento... se manifesta" 
        intervals [185]:
            xmin = 833.8541127882966 
            xmax = 836.680522818634 
            text = "..." 
        intervals [186]:
            xmin = 836.680522818634 
            xmax = 841.1638357964831 
            text = "Lévi-Strauss em La Pensée Sauvage... diz o seguinte" 
        intervals [187]:
            xmin = 841.1638357964831 
            xmax = 841.8736454403842 
            text = "..." 
        intervals [188]:
            xmin = 841.8736454403842 
            xmax = 849.4762646735871 
            text = "''por que nós supomos que o nosso modo... de interpretar o mundo... é... o modo verdadeiro?''" 
        intervals [189]:
            xmin = 849.4762646735871 
            xmax = 850.8130741836248 
            text = "..." 
        intervals [190]:
            xmin = 850.8130741836248 
            xmax = 865.4747665247219 
            text = "e ele encontra no pensamento... de certos grupos... ah selvagens... alguma coisa que está mais de acordo... com a física atômica... compreende?" 
        intervals [191]:
            xmin = 865.4747665247219 
            xmax = 865.7413616961402 
            text = "..." 
        intervals [192]:
            xmin = 865.7413616961402 
            xmax = 868.6477502779032 
            text = "porque eu acho eu não não estou de acordo com isto" 
        intervals [193]:
            xmin = 868.6477502779032 
            xmax = 870.6447413007452 
            text = "..." 
        intervals [194]:
            xmin = 870.6447413007452 
            xmax = 877.7741541046805 
            text = "--eu não andei pichando muito Lévi-Strauss para vocês porque senão vocês não conhecem mas eu há anos que eu... me bato contra o Estruturalismo--" 
        intervals [195]:
            xmin = 877.7741541046805 
            xmax = 878.9280378979121 
            text = "..." 
        intervals [196]:
            xmin = 878.9280378979121 
            xmax = 889.1288601899093 
            text = "em todo o caso... neste nível de análise... eu creio que nós podemos utilizarmos desta reflexão" 
        intervals [197]:
            xmin = 889.1288601899093 
            xmax = 891.2639030821687 
            text = "..." 
        intervals [198]:
            xmin = 891.2639030821687 
            xmax = 901.2789929029229 
            text = "para um grande número... de grupos humanos... existem então... forças que surgem... que se manifestam então" 
        intervals [199]:
            xmin = 901.2789929029229 
            xmax = 903.900009815803 
            text = "..." 
        intervals [200]:
            xmin = 903.900009815803 
            xmax = 909.4163790828976 
            text = "o verbo entre os hopi... tem... duas categorias" 
        intervals [201]:
            xmin = 909.4163790828976 
            xmax = 910.3734697054366 
            text = "segundo Whorf" 
        intervals [202]:
            xmin = 910.3734697054366 
            xmax = 911.0999415475513 
            text = "..." 
        intervals [203]:
            xmin = 911.0999415475513 
            xmax = 917.2971674103823 
            text = "notem eu não sei... se isto não foi completamente transformado pela linguística moderna" 
        intervals [204]:
            xmin = 917.2971674103823 
            xmax = 918.2018695573383 
            text = "..." 
        intervals [205]:
            xmin = 918.2018695573383 
            xmax = 935.64199248153 
            text = "na época em que eu estive nos Estados Unidos... Sapir tinha morrido há pouco tempo e esta corrente... Edward Sapir (Benjamin Whorf) ( )... Hayakawa Korzybski... era gente que tinha uma importância muito grande na Linguística" 
        intervals [206]:
            xmin = 935.64199248153 
            xmax = 937.0849388468313 
            text = "..." 
        intervals [207]:
            xmin = 937.0849388468313 
            xmax = 943.941091600063 
            text = "isto... antes de Jakobson começar a visitar os Estados Unidos depois o Estruturalismo linguístico dominou" 
        intervals [208]:
            xmin = 943.941091600063 
            xmax = 944.6998124479736 
            text = "..." 
        intervals [209]:
            xmin = 944.6998124479736 
            xmax = 945.9494773139967 
            text = "acho que a Linguística de um modo" 
        intervals [210]:
            xmin = 945.9494773139967 
            xmax = 948.3091665625802 
            text = "..." 
        intervals [211]:
            xmin = 948.3091665625802 
            xmax = 974.7107294757415 
            text = "mas::... o que eu quero salientar é que... sem entrarmos em hipóteses... porque a hipótese de Whorf... e de ( )... como eu disse a vocês... é a hipótese... que a importância soberana da língua... deriva... talvez de um modo mais claro exis/" 
        intervals [212]:
            xmin = 974.7107294757415 
            xmax = 979.2015670097237 
            text = "no século dezoito existiram... indivíduos que... defenderam esta ideia" 
        intervals [213]:
            xmin = 979.2015670097237 
            xmax = 981.3416737054312 
            text = "( )... e outros" 
        intervals [214]:
            xmin = 981.3416737054312 
            xmax = 982.1447916593286 
            text = "..." 
        intervals [215]:
            xmin = 982.1447916593286 
            xmax = 986.4291971672336 
            text = "quem deu uma feição mais científica foi... Humboldt" 
        intervals [216]:
            xmin = 986.4291971672336 
            xmax = 991.1577133064812 
            text = "..." 
        intervals [217]:
            xmin = 991.1577133064812 
            xmax = 1016.7380425918815 
            text = "a ideia de que... o indivíduo... PEN::sa... por meio de símbolos linguísticos... a estrutura da língua... então dita... a forma do pensamento... o indivíduo vê... o universo... através dos rótulos que a língua coloca sobre o universo... a ação do indivíduo é norteada pela língua" 
        intervals [218]:
            xmin = 1016.7380425918815 
            xmax = 1018.1639455391232 
            text = "..." 
        intervals [219]:
            xmin = 1018.1639455391232 
            xmax = 1026.8483371301215 
            text = "há então... uma influência... da língua... que é DEcisiva na formação do pensamento" 
        intervals [220]:
            xmin = 1026.8483371301215 
            xmax = 1027.6830779025881 
            text = "..." 
        intervals [221]:
            xmin = 1027.6830779025881 
            xmax = 1032.4067874511068 
            text = "mas... a começar pela própria percepção" 
        intervals [222]:
            xmin = 1032.4067874511068 
            xmax = 1035.11640092298 
            text = "..." 
        intervals [223]:
            xmin = 1035.11640092298 
