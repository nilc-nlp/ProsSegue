        intervals [649]:
            xmin = 2600.622160855707 
            xmax = 2621.6511629787788 
            text = "existe... na concepção estruturalista... uma ideia de estrutura linguística que demasiado rígida... para meu gosto... porque... o característico... de todo organismo de todo sistema vivo... é o contínuo devir é a mudança... contínua" 
        intervals [650]:
