        intervals [123]:
            xmin = 501.8545827588228 
            xmax = 511.2249554382469 
            text = "isto é muito... uma hipótese derivada... de uma psicologia de um reforço de situações que eu acho que não explica toda a questão" 
        intervals [124]:
            xmin = 511.2249554382469 
            xmax = 511.87295355088713 
            text = "..." 
        intervals [125]:
            xmin = 511.87295355088713 
            xmax = 516.2712579574904 
            text = "mas em suma... o que é fundamental é o seguinte" 
        intervals [126]:
            xmin = 516.2712579574904 
            xmax = 558.684750898841 
            text = "as noções de espaço e de tempo as noções de causalidade... as noções relativas aos problemas fundamentais da existência... que guiam... que põem... direções que dão pautas... à ação dos grupos... são derivadas de conceitos... que... radicam vamos dizer que... saem... se não se se não são totalmente determinados são em grande parte determinados... por... hábitos linguísticos... certo?" 
        intervals [127]:
            xmin = 558.684750898841 
            xmax = 560.5017074329985 
            text = "..." 
        intervals [128]:
            xmin = 560.5017074329985 
            xmax = 562.821067851622 
            text = "isto é... voltando aos hopi" 
        intervals [129]:
            xmin = 562.821067851622 
            xmax = 565.1084456158673 
            text = "..." 
        intervals [130]:
            xmin = 565.1084456158673 
            xmax = 576.964097514732 
            text = "existe... na mitologia hopi... a ideia fundamental de uma... força atuante central que é o coração do universo" 
        intervals [131]:
            xmin = 576.964097514732 
            xmax = 579.8517026237287 
            text = "..." 
        intervals [132]:
            xmin = 579.8517026237287 
            xmax = 589.481783931275 
            text = "desta força central derivam... forças parciais... que animam... tudo o que existe no universo" 
        intervals [133]:
            xmin = 589.481783931275 
            xmax = 592.2118418835047 
            text = "..." 
        intervals [134]:
            xmin = 592.2118418835047 
            xmax = 595.3393177613021 
            text = "então... não existe nada de inanimado" 
        intervals [135]:
            xmin = 595.3393177613021 
            xmax = 595.5182114651396 
            text = "..." 
        intervals [136]:
            xmin = 595.5182114651396 
            xmax = 609.461419952859 
            text = "vocês encontram em certos manuais sobretudo manuais brasileiros... que estão quarenta ou cinquenta anos em retardo sobre a... os avanços da ciência... vocês encontram a palavra animismo" 
        intervals [137]:
            xmin = 609.461419952859 
            xmax = 609.7049740315776 
            text = "..." 
        intervals [138]:
            xmin = 609.7049740315776 
            xmax = 610.5479225570839 
            text = "--já ouviram falar nisso?--" 
        intervals [139]:
            xmin = 610.5479225570839 
            xmax = 612.1930072641774 
            text = "..." 
        intervals [140]:
            xmin = 612.1930072641774 
            xmax = 613.8892644318903 
            text = "é uma concepção falsa" 
        intervals [141]:
            xmin = 613.8892644318903 
            xmax = 616.5477092118491 
            text = "..." 
        intervals [142]:
            xmin = 616.5477092118491 
            xmax = 634.3154045732158 
            text = "porque supôs-se... a princípio nos primeiros contatos entre... muitas vezes missionários exploradores e povos de outra tradição que não a ocidental... que eles atribuíram uma ALma... a objetos e a plantas" 
        intervals [143]:
            xmin = 634.3154045732158 
            xmax = 635.5073108168564 
            text = "..." 
        intervals [144]:
            xmin = 635.5073108168564 
            xmax = 655.9419331146605 
            text = "mas a noção de alma é uma noção complexa... é uma noção que foi... refinada... através... da tradição judaica... ahn da filosofia grega... que foi um dos componentes essenciais... do:: CristiaNISmo compreendem?" 
        intervals [145]:
            xmin = 655.9419331146605 
            xmax = 656.280004104322 
            text = "..." 
        intervals [146]:
            xmin = 656.280004104322 
            xmax = 660.9744562519411 
            text = "não há uma atribuição de alma:: a objetos ou a plantas" 
        intervals [147]:
            xmin = 660.9744562519411 
            xmax = 661.8021090504185 
            text = "..." 
        intervals [148]:
            xmin = 661.8021090504185 
            xmax = 671.9863700575387 
            text = "supõe-se que estas plantas... os objetos o mundo inteiro... é animado de certa forças compreendem?" 
        intervals [149]:
            xmin = 671.9863700575387 
            xmax = 673.7043462058421 
            text = "..." 
        intervals [150]:
            xmin = 673.7043462058421 
            xmax = 677.622071793634 
            text = "forças... éh que se revelam em certo momento" 
        intervals [151]:
            xmin = 677.622071793634 
            xmax = 681.9273680982549 
            text = "então elas existem em estado latente... compreendem?" 
        intervals [152]:
            xmin = 681.9273680982549 
            xmax = 684.1451598143647 
            text = "..." 
        intervals [153]:
            xmin = 684.1451598143647 
            xmax = 692.0080678032441 
            text = "então há uma espécie de eterno p::resente... que é um presente mitológico" 
        intervals [154]:
            xmin = 692.0080678032441 
            xmax = 694.7851716840165 
            text = "..." 
        intervals [155]:
            xmin = 694.7851716840165 
            xmax = 698.2016027628888 
            text = "o mito... não é um acontecimento do passado" 
        intervals [156]:
            xmin = 698.2016027628888 
            xmax = 700.6942311336376 
            text = "..." 
        intervals [157]:
            xmin = 700.6942311336376 
            xmax = 707.1163504281703 
            text = "o mito é algo que aconteceu... segundo... um esquema narrativo" 
        intervals [158]:
