        intervals [647]:
            xmin = 2577.9067078455723 
            xmax = 2599.5006774938433 
            text = "quer dizer em toda língua... há... uma parte cristalizada no sistema... e há... a língua que se elabora... que está se fazendo... uma língua que lança mão de recursos expressivos da linguagem... para criar novas aplicações de termos" 
