            text = "..." 
        intervals [637]:
            xmin = 2536.075860087924 
            xmax = 2548.084691357089 
            text = "um crítico disse... ''os absurdos da pseudo da escola pseudocientífica que saiu de Coimbra... um verde moço moço é um adjetivo que só se pode aplicar a coisas humanas''" 
        intervals [638]:
            xmin = 2548.084691357089 
