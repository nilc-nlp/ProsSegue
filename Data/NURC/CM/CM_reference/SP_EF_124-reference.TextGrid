        intervals [33]:
            xmin = 154.57925988883608 
            xmax = 169.45763487695686 
            text = "aqui o Whorf diz... não há ideia então... de um conTInuum... compreendem?... isto é... alguma coisa que se perde numa perspectiva infinita às nossas costas" 
        intervals [34]:
