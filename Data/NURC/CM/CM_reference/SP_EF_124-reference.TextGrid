            xmax = 350.24589313388117 
            text = "..." 
        intervals [85]:
            xmin = 350.24589313388117 
            xmax = 370.5161975411453 
            text = "então esta mobilidade deu uma certa ideia de mobilidade social... e de mobilidade no tempo e o espaço... até nós chegarmos às ideias de tempo e espaço... que existem na nossa cultura... e que são o fruto da elaboração milenar do pensamento" 
