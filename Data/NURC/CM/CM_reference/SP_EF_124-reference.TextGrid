        intervals [39]:
            xmin = 177.47782688052263 
            xmax = 187.83119951656897 
            text = "e alguma coisa que se dirige... para um horizonte e se perde no fim do horizonte... que nós chamamos de futuro... certo?" 
        intervals [40]:
            xmin = 187.83119951656897 
            xmax = 189.65882976808595 
            text = "..." 
        intervals [41]:
            xmin = 189.65882976808595 
            xmax = 198.78615058731097 
            text = "isto é... como eu disse a vocês... uma das ideias fundamentais no ocidente... é a ideia de viagem" 
        intervals [42]:
            xmin = 198.78615058731097 
            xmax = 199.90587095885854 
            text = "..." 
        intervals [43]:
            xmin = 199.90587095885854 
            xmax = 201.37598001810125 
            text = "a ideia de peregrinação" 
        intervals [44]:
            xmin = 201.37598001810125 
            xmax = 203.37942093576257 
            text = "..." 
        intervals [45]:
            xmin = 203.37942093576257 
            xmax = 208.74569985926772 
            text = "nós podemos aproximar isto então... da literatura religiosa do ocidente" 
        intervals [46]:
            xmin = 208.74569985926772 
            xmax = 209.76505266230933 
            text = "..." 
        intervals [47]:
            xmin = 209.76505266230933 
            xmax = 213.1318309223367 
            text = "''nossa vida é um via/ é uma viagem pelo vale de lágrimas''" 
        intervals [48]:
            xmin = 213.1318309223367 
            xmax = 214.08 
            text = "--vocês já não ouviram isso?--" 
        intervals [49]:
            xmin = 214.08 
            xmax = 219.9871511296347 
            text = "tem alguns católicos que... vão à igreja ao domingo... e ouvem sermões não é?" 
        intervals [50]:
            xmin = 219.9871511296347 
            xmax = 236.2313510273355 
            text = "esta ideia da viagem eu creio que tenha uma importância imensa... em todas as mitologias que influenciaram... i::sto este todo extremamente complexo... que se chama... a civilização ocidental" 
        intervals [51]:
            xmin = 236.2313510273355 
            xmax = 238.32938994000855 
            text = "..." 
        intervals [52]:
            xmin = 238.32938994000855 
            xmax = 256.39846380350394 
            text = "uma das primeiras... obras literárias que se conhece da humanidade... é a epopeia de Gilgamesh... que::... foi escrita em língua assíria se não me engano ou sumeriana eu não sei em que diabo de língua foi escrita" 
        intervals [53]:
            xmin = 256.39846380350394 
            xmax = 257.02025147654604 
            text = "..." 
        intervals [54]:
            xmin = 257.02025147654604 
            xmax = 259.46535514502744 
            text = "e que aliás até hoje se lê com:: agrado" 
        intervals [55]:
            xmin = 259.46535514502744 
            xmax = 262.0936443046352 
            text = "..." 
        intervals [56]:
            xmin = 262.0936443046352 
            xmax = 268.4432829865517 
            text = "em que a::... Gilgamesh tem um amigo que chama-se Enquidu esse amigo... era imortal" 
        intervals [57]:
            xmin = 268.4432829865517 
            xmax = 269.66669346349204 
            text = "..." 
        intervals [58]:
            xmin = 269.66669346349204 
            xmax = 272.32016766694966 
            text = "e ela tinha a simplicidade dos animais" 
        intervals [59]:
            xmin = 272.32016766694966 
            xmax = 273.0748813823296 
            text = "..." 
        intervals [60]:
            xmin = 273.0748813823296 
            xmax = 277.7064797781074 
            text = "de repente ele conhece a mulher e através da mulher... a doença a morte" 
        intervals [61]:
            xmin = 277.7064797781074 
            xmax = 284.954699295013 
            text = "são lendas... que PREexistiram à elaboração da Bíblia... e tiveram uma influência muito grande sobre a Bíblia" 
        intervals [62]:
            xmin = 284.954699295013 
            xmax = 285.84 
            text = "..." 
        intervals [63]:
            xmin = 285.84 
