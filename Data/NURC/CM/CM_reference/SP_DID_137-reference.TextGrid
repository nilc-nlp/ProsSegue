            xmin = 2228.1435611589454 
            xmax = 2229.0107106657347 
            text = "..." 
        intervals [1666]:
            xmin = 2229.0107106657347 
            xmax = 2229.2659913812354 
            text = "quer dizer" 
        intervals [1667]:
            xmin = 2229.2659913812354 
            xmax = 2233.0185013408354 
            text = "igreja do estilo da catedral de São Paulo a gente encontra na Europa inteira" 
        intervals [1668]:
            xmin = 2233.0185013408354 
            xmax = 2233.9753510127216 
            text = "..." 
        intervals [1669]:
            xmin = 2233.9753510127216 
            xmax = 2235.7241325908312 
            text = "na verdade nos Estados Unidos eu não fui a nenhuma igreja" 
        intervals [1670]:
            xmin = 2235.7241325908312 
            xmax = 2240.183236734781 
            text = "só fui a uma que foi é:: a igreja de S/ éh acho que é Saint Patrick em:: em Nova Iorque" 
