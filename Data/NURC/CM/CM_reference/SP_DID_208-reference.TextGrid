    item [6]:
        class = "IntervalTier" 
        name = "TB-L1-normal" 
        xmin = 0 
        xmax = 2640.08 
        intervals: size = 580 
        intervals [1]:
            xmin = 0 
            xmax = 23.06906 
            text = "" 
        intervals [2]:
            xmin = 23.06906 
            xmax = 30.44399 
            text = "eu nílton chaves sou nascido aqui na capital em vinte e um de maio de mil novecentos e vinte e oito" 
        intervals [3]:
            xmin = 30.44399 
            xmax = 31.27028 
            text = "" 
        intervals [4]:
            xmin = 31.27028 
            xmax = 37.36662 
            text = "nasci no bairro da luz mas logo depois meus pais mudaram para a vila mariana" 
        intervals [5]:
            xmin = 37.36662 
            xmax = 38.44933 
            text = "" 
        intervals [6]:
            xmin = 38.44933 
            xmax = 41.08527 
            text = "se não me falha a memória rua joaquim távora" 
        intervals [7]:
            xmin = 41.08527 
            xmax = 42.75432 
            text = "" 
        intervals [8]:
            xmin = 42.75432 
            xmax = 49.11333 
            text = "somos em três rapazes depois em mil novecentos e trinta e um nasceu uma irmã" 
        intervals [9]:
            xmin = 49.11333 
            xmax = 49.79157 
            text = "" 
        intervals [10]:
            xmin = 49.79157 
            xmax = 52.24612 
            text = "é a única irmã que eu tenho legítima" 
        intervals [11]:
            xmin = 52.24612 
            xmax = 53.61934 
            text = "" 
        intervals [12]:
            xmin = 53.61934 
            xmax = 60.96325 
            text = "posteriormente em mil novecentos e trinta e nove meu pai pegou uma menina para criar" 
        intervals [13]:
            xmin = 60.96325 
            xmax = 61.19775 
            text = "" 
        intervals [14]:
            xmin = 61.19775 
            xmax = 62.44135 
            text = "filha de japoneses" 
        intervals [15]:
            xmin = 62.44135 
            xmax = 64.68473 
            text = "" 
        intervals [16]:
            xmin = 64.68473 
            xmax = 74.67897 
            text = "então essa menina hoje já está com trinta e cinco anos professora primária e advogada residente em santos" 
        intervals [17]:
            xmin = 74.67897 
            xmax = 76.07418 
            text = "" 
        intervals [18]:
            xmin = 76.07418 
            xmax = 80.55785 
            text = "agora minha infância foi infância normal de toda todo moleque" 
        intervals [19]:
            xmin = 80.55785 
            xmax = 108.88124 
            text = "nascido em vinte e oito em vinte e nove com os negócios indo tudo para o buraco falências tudo mais meu pai também teve um prejuízo muito grande então nós fomos obrigados a mudar duma casa grande que nós morávamos pruma casinha pequena com meu pai tinha naquela ocasião já tinha automóvel tinha geladeira elétrica e vendeu tudo e passamos a uma vida mais ou menos apertada" 
        intervals [20]:
            xmin = 108.88124 
            xmax = 109.63302 
            text = "" 
        intervals [21]:
            xmin = 109.63302 
            xmax = 116.71429 
            text = "basta dizer que minha mãe mesmo grávida de nove meses era ela que tomava conta da casa sem empregada lavava toda roupa" 
        intervals [22]:
            xmin = 116.71429 
            xmax = 117.97213 
            text = "" 
        intervals [23]:
            xmin = 117.97213 
            xmax = 130.99637 
            text = "logo depois que eu nasci minha mãe teve que fazer operação de apêndice que naquele tempo era um deus nos acuda e ela ficou no hospital durante cerca de vinte dias" 
        intervals [24]:
            xmin = 130.99637 
            xmax = 131.8614 
            text = "" 
        intervals [25]:
            xmin = 131.8614 
            xmax = 137.87333 
            text = "e eu fiquei na mão de uma empregada que quando se lembrava dava mamadeira quando não se lembrava não dava" 
        intervals [26]:
            xmin = 137.87333 
            xmax = 139.10281 
            text = "" 
        intervals [27]:
            xmin = 139.10281 
            xmax = 144.59677 
            text = "quando se lembrava de ver se o leite estava bom ela via se não o leite ia estragado mesmo" 
        intervals [28]:
            xmin = 144.59677 
            xmax = 145.34451 
            text = "" 
        intervals [29]:
            xmin = 145.34451 
            xmax = 158.05104 
            text = "nessas condições quando minha mãe voltou da ma do hospital eu estava num estado de subnutrição de fraqueza que o próprio médico pediatra achou um absurdo isso" 
        intervals [30]:
            xmin = 158.05104 
            xmax = 158.27824 
            text = "" 
        intervals [31]:
            xmin = 158.27824 
            xmax = 162.41848 
            text = "brigou com minha mãe devido o fato d de ter deixado eu estar nessa situação" 
        intervals [32]:
            xmin = 162.41848 
            xmax = 163.18889 
            text = "" 
        intervals [33]:
            xmin = 163.18889 
            xmax = 173.98941 
            text = "então ela fez um um regime de de engorda de fortalecimento durante muitos anos e com isso graças a deus eu voltei a a ser um alguém" 
        intervals [34]:
            xmin = 173.98941 
            xmax = 175.24546 
            text = "" 
        intervals [35]:
            xmin = 175.24546 
            xmax = 183.39416 
            text = "agora os meus irmãos também sempre foram rapazes sadios mas todos eles têm um uma tragédia na vida" 
        intervals [36]:
            xmin = 183.39416 
            xmax = 184.57441 
            text = "" 
        intervals [37]:
            xmin = 184.57441 
            xmax = 192.97792 
            text = "o mano mais velho caiu duma escada na casa dos meus avós com vinte e tantos degraus chegou lá embaixo disse que tinha sangue até pelo ouvido" 
        intervals [38]:
            xmin = 192.97792 
            xmax = 193.88648 
            text = "" 
        intervals [39]:
            xmin = 193.88648 
            xmax = 198.37027 
            text = "também graças a deus não aconteceu nada de de consequência" 
        intervals [40]:
            xmin = 198.37027 
            xmax = 199.62716 
            text = "" 
        intervals [41]:
            xmin = 199.62716 
            xmax = 200.26523 
            text = "meus" 
        intervals [42]:
            xmin = 200.26523 
            xmax = 200.65183 
            text = "" 
        intervals [43]:
            xmin = 200.65183 
            xmax = 201.7438 
            text = "eu sou o segundo" 
        intervals [44]:
            xmin = 201.7438 
            xmax = 214.25423 
            text = "o terceiro que hoje é agrônomo do estado em mil novecentos e trinta e dois durante a revolução caiu da janela do s sobrado na rua correia dias onde morávamos" 
        intervals [45]:
            xmin = 214.25423 
            xmax = 215.34597 
            text = "" 
        intervals [46]:
            xmin = 215.34597 
            xmax = 229.52866 
            text = "entre outras coisas sofreu fratura do crânio teve hospitalizado em estado desesperador estado de coma mas felizmente conseguiu escapar e ele está trabalhando hoje mora em americana" 
        intervals [47]:
            xmin = 229.52866 
            xmax = 230.96106 
            text = "" 
        intervals [48]:
            xmin = 230.96106 
            xmax = 239.39128 
            text = "e minha irmã com três anos de idade sofreu queimadura com água fervendo eh pelo corpo todo" 
        intervals [49]:
            xmin = 239.39128 
            xmax = 239.52944 
            text = "" 
        intervals [50]:
            xmin = 239.52944 
            xmax = 240.84319 
            text = "queimadura de terceiro grau" 
        intervals [51]:
            xmin = 240.84319 
            xmax = 242.12001 
            text = "" 
        intervals [52]:
            xmin = 242.12001 
            xmax = 250.99542 
            text = "também graças a deus salvou-se e hoje diz ela que na parte do ventre só tem uma ligeira m mancha vermelha" 
        intervals [53]:
            xmin = 250.99542 
            xmax = 252.29952 
            text = "nem cicatriz não ficou" 
        intervals [54]:
            xmin = 252.29952 
            xmax = 254.80639 
            text = "" 
        intervals [55]:
            xmin = 254.80639 
            xmax = 260.38232 
            text = "nós moramos quase toda nossa vida na no bairro de vila mariana" 
        intervals [56]:
            xmin = 260.38232 
            xmax = 261.01505 
            text = "" 
        intervals [57]:
            xmin = 261.01505 
            xmax = 272.08052 
            text = "moramos na rua correia dias dali mudamos para rua apeninos esquina da nicolau de sousa queirós quando a casa foi vendida" 
        intervals [58]:
            xmin = 272.08052 
            xmax = 279.3675 
            text = "meu pai então con ah estava já construindo uma residência na rua gualachos" 
        intervals [59]:
            xmin = 279.3675 
            xmax = 280.17808 
            text = "" 
        intervals [60]:
            xmin = 280.17808 
            xmax = 283.98801 
            text = "rua gualachos cento e trinta e seis perto do tênis clube paulista" 
        intervals [61]:
