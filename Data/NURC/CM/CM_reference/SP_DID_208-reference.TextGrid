            text = "..." 
        intervals [2234]:
            xmin = 2617.0918515587014 
            xmax = 2619.156995848649 
            text = "Júlia Alves:: Chaves" 
        intervals [2235]:
            xmin = 2619.156995848649 
            xmax = 2619.7642422735335 
            text = "..." 
        intervals [2236]:
            xmin = 2619.7642422735335 
            xmax = 2622.897715190935 
            text = "então minha mãe assina exclusivamente Júlia Chaves" 
        intervals [2237]:
            xmin = 2622.897715190935 
            xmax = 2623.939163061201 
            text = "..." 
        intervals [2238]:
            xmin = 2623.939163061201 
            xmax = 2624.4629919281897 
            text = "daí::" 
        intervals [2239]:
            xmin = 2624.4629919281897 
            xmax = 2626.626370813267 
            text = "meu avô jamais se conformou com isso" 
        intervals [2240]:
            xmin = 2626.626370813267 
            xmax = 2628.3020227109 
            text = "muito embora tenha:: falecido a" 
        intervals [2241]:
