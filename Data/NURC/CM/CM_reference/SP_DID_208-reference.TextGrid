            text = "quando viu" 
        intervals [2223]:
            xmin = 2604.149990901843 
            xmax = 2604.435164546892 
            text = "..." 
        intervals [2224]:
            xmin = 2604.435164546892 
            xmax = 2605.7375667579154 
            text = "a:: situação" 
        intervals [2225]:
            xmin = 2605.7375667579154 
            xmax = 2607.3234196195835 
            text = "ele consentiu o casamento" 
        intervals [2226]:
            xmin = 2607.3234196195835 
