            text = "..." 
        intervals [2227]:
            xmin = 2607.891685145316 
            xmax = 2609.2786040620754 
            text = "não sei se por isso" 
        intervals [2228]:
            xmin = 2609.2786040620754 
            xmax = 2612.251868747494 
            text = "ou simplesmente para evitar um:: choque" 
