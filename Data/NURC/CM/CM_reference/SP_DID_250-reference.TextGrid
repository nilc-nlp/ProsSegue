        intervals [6]:
            xmin = 30.030458471802724 
            xmax = 44.78574795463664 
            text = "de maneira que SÓ... os que têm muito... ou::... os que estão diretamente envolvidos... no::... nesse ramo de atividades  é que... teriam::... mais coisas a dizer" 
        intervals [7]:
            xmin = 44.78574795463664 
