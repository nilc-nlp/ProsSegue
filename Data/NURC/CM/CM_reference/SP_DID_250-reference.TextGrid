            text = "..." 
        intervals [8]:
            xmin = 45.71163264968718 
            xmax = 69.29323402496847 
            text = "na realidade minha família... que por tradição é uma família de bacharéis... em Direito... meu pai o era... meu irmão mais velho também... e eu... antes de me licenciar em História pela... Universidade de São Paulo... também... me:: diplomei em Ciências Jurídicas e Sociais como eles dizem... está escrito no diploma" 
        intervals [9]:
            xmin = 69.29323402496847 
