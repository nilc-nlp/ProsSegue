            text = "..." 
        intervals [10]:
            xmin = 70.29263334640324 
            xmax = 72.09694001434788 
            text = "mas tive um irmão que trabalhou em banco" 
        intervals [11]:
            xmin = 72.09694001434788 
            xmax = 73.27143431609748 
            text = "..." 
        intervals [12]:
            xmin = 73.27143431609748 
            xmax = 76.78666917019405 
            text = "quer dizer aPEnas... no grau de funcionário" 
        intervals [13]:
            xmin = 76.78666917019405 
            xmax = 77.9707401053722 
            text = "..." 
        intervals [14]:
            xmin = 77.9707401053722 
            xmax = 83.89213745618402 
            text = "onde adquiriu muito renome... chamava-se Mário... esse meu irmão Mário... de Andrade e Silva" 
        intervals [15]:
            xmin = 83.89213745618402 
            xmax = 85.64108626869488 
            text = "..." 
        intervals [16]:
            xmin = 85.64108626869488 
            xmax = 95.9532355547797 
            text = "éh::... embora no tempo dele tenha si/... sido mais célebre como... futebolista... amador... no Clube Atlético Paulistano do que como funcionário de banco" 
        intervals [17]:
            xmin = 95.9532355547797 
            xmax = 96.50181887795857 
            text = "..." 
        intervals [18]:
            xmin = 96.50181887795857 
            xmax = 98.63124742007824 
            text = "mas em todo caso foi funcionário do Banco Comercial" 
        intervals [19]:
            xmin = 98.63124742007824 
            xmax = 99.66224086119533 
            text = "..." 
        intervals [20]:
            xmin = 99.66224086119533 
            xmax = 115.22261216200194 
            text = "e::... agora... o que eu conheço de bancos... deriva simplesmente do trato... normal... entre um... peQUEno depositante... que eu sou... porque a gente tem que guardar o dinheiro em algum lugar" 
        intervals [21]:
            xmin = 115.22261216200194 
            xmax = 116.42482486145663 
            text = "..." 
        intervals [22]:
            xmin = 116.42482486145663 
            xmax = 121.83105295958534 
            text = "começa que a Universidade já nos paga Obrigatoriamente pelo Banco do Estado de São Paulo" 
        intervals [23]:
            xmin = 121.83105295958534 
            xmax = 123.1058429008855 
            text = "..." 
        intervals [24]:
            xmin = 123.1058429008855 
            xmax = 127.61379557387792 
            text = "então... éh::... esse é o tipo de relacionamento que eu tenho com banco" 
        intervals [25]:
            xmin = 127.61379557387792 
            xmax = 128.52770880598325 
            text = "..." 
        intervals [26]:
            xmin = 128.52770880598325 
            xmax = 142.8373431125462 
            text = "eventualmente tive:: também:: a um::: um vez por outra... a necessidade de::... um pequeno empréstimo então recorri a bancos... e vi como eles são exigentes... para emprestar" 
        intervals [27]:
            xmin = 142.8373431125462 
            xmax = 144.38331980114876 
            text = "..." 
        intervals [28]:
            xmin = 144.38331980114876 
            xmax = 152.52807794715216 
            text = "e muito mais:: PRÁticos... a:: no:: que tange a:: receber depósitos" 
        intervals [29]:
            xmin = 152.52807794715216 
            xmax = 153.2399795349638 
            text = "..." 
        intervals [30]:
            xmin = 153.2399795349638 
            xmax = 161.81551839903366 
            text = "quer dizer eles recebem... o dinheiro da gente é com extrema facilidade... e soltam... com... bastante dificuldade" 
        intervals [31]:
            xmin = 161.81551839903366 
            xmax = 162.19241257452046 
            text = "..." 
        intervals [32]:
            xmin = 162.19241257452046 
            xmax = 163.62399493127091 
            text = "e com com muitas exigências" 
        intervals [33]:
            xmin = 163.62399493127091 
            xmax = 165.10347596211727 
            text = "..." 
        intervals [34]:
            xmin = 165.10347596211727 
            xmax = 169.08601287668372 
            text = "agora o que mais que eu poderia dizer com referência a bancos?... e finanças?" 
        intervals [35]:
            xmin = 169.08601287668372 
            xmax = 170.53093209740086 
            text = "..." 
        intervals [36]:
            xmin = 170.53093209740086 
            xmax = 194.05276853088787 
            text = "bem o o dentro do do contexto capitalista em que nós vivemos o banco é:: realmente... um::... um instrumento... de:: muita importância... nas::... atividades gerais de de de de::... de produção" 
        intervals [37]:
            xmin = 194.05276853088787 
            xmax = 195.90940721377456 
            text = "..." 
        intervals [38]:
            xmin = 195.90940721377456 
            xmax = 210.09810079048816 
            text = "a os organismos empresariais sobretudo é que têm necessidade de ter... relações digamos mais... éh... mais constantes... e::... mais vulTOsas em relação a bancos" 
        intervals [39]:
            xmin = 210.09810079048816 
            xmax = 212.43570513367325 
            text = "..." 
        intervals [40]:
            xmin = 212.43570513367325 
            xmax = 221.22157814003435 
            text = "agora quem sabe se vocês PREcisando... melhor ou ah... insistindo em determinadas perguntas eu poderia dizer mais alguma coisa" 
        intervals [41]:
            xmin = 221.22157814003435 
            xmax = 235.2459477390067 
            text = "..." 
        intervals [42]:
            xmin = 235.2459477390067 
            xmax = 258.0590979209729 
            text = "BOm o empregado... normalmente... qualquer:: ahn:: empregado... deve ser admitido... pelas empresas... dentro das exigências... da::... legislação trabalhista... a cê ele tê... Consolidação das Leis do Trabalho" 
        intervals [43]:
            xmin = 258.0590979209729 
            xmax = 258.496535790352 
            text = "..." 
        intervals [44]:
            xmin = 258.496535790352 
            xmax = 284.9817892066983 
            text = "então ele deve estar... ahn::... regulamentarmente registrado... (no) livro de trabalho... deve ser portador da carteira de trabalho... e em ambos os assentamentos do livro de trabalho na carteira de trabalho devem constar as condições... em que ele trabalha... hora de trabalho... salário... assentamento de férias pagas... em suma... todas as garantias... que a Legislação Trabalhista exige" 
        intervals [45]:
            xmin = 284.9817892066983 
            xmax = 286.1293140050209 
            text = "..." 
        intervals [46]:
            xmin = 286.1293140050209 
            xmax = 329.7358482796527 
            text = "se ele vem a ser despedido... de duas uma... ou o patrão... comprova... causa justa... que é uma situação prevista na Legislação do Trabalho... comprova... causa justa... para a::... a demissão... e então... haverá um acordo... com referência... àquilo... àquilo que o::... trabalhador nesse caso tem direito a receber... OU... se não se comprova a causa justa... o trabalhador dispensado... recorre à Justiça do Trabalho fazendo o que se chama uma reclamação" 
        intervals [47]:
            xmin = 329.7358482796527 
            xmax = 331.21606007281736 
            text = "..." 
        intervals [48]:
            xmin = 331.21606007281736 
            xmax = 346.1972043916 
            text = "através dessa reclamação então... as partes... em conflito... quer dizer... o Operário despedido... e o patrão que o despediu... devem... provar a legalidade das respectivas atitudes" 
        intervals [49]:
            xmin = 346.1972043916 
            xmax = 348.3527202395948 
            text = "..." 
        intervals [50]:
            xmin = 348.3527202395948 
            xmax = 359.24 
            text = "conforme o que ficar demonstrado... perante a Justiça Trabalhista... até julgamento final... o::... trabalhador recebe... àquilo a que ele tem direito" 
        intervals [51]:
            xmin = 359.24 
            xmax = 361.37106772513823 
            text = "..." 
        intervals [52]:
            xmin = 361.37106772513823 
            xmax = 382.499881562961 
            text = "agora... eu tenho... a impressão... de que... a Justiça Trabalhista... eu não vou dizer que ela::... falha sempre... mas ela funciona muito mais... no sentido dos interesses... patronais... que dos trabalhistas" 
        intervals [53]:
            xmin = 382.499881562961 
            xmax = 384.2220944346793 
            text = "..." 
        intervals [54]:
            xmin = 384.2220944346793 
            xmax = 397.0097305166854 
            text = "mas é uma impressão... eu diria quase que de leigo porque eu não tenho... como bacharel em Direito eu não TEnho... experiência de advocacia em Justiça Trabalhista" 
        intervals [55]:
            xmin = 397.0097305166854 
            xmax = 399.62974588979336 
            text = "..." 
        intervals [56]:
            xmin = 399.62974588979336 
            xmax = 423.6008556846689 
            text = "eu hoje estou confinado às minhas atividades de professor universitário... felizmente... estou muito contente com isso... vivo num ambiente sadio gosto de conviver com os meus discípulos... com os meus colegas... e::  estou afastado dessa... desse burburinho... desse corpo a corpo da da... da advocacia e da Justiça" 
        intervals [57]:
            xmin = 423.6008556846689 
            xmax = 431.3651245719494 
            text = "..." 
        intervals [58]:
            xmin = 431.3651245719494 
            xmax = 444.63400041805676 
            text = "bem... eu... eu devo dizer que::... ahn::... o que vou declarar... é muito aleatório porque como nós acabamos de ver eu não... SOU... um advogado militante" 
        intervals [59]:
            xmin = 444.63400041805676 
            xmax = 446.21721908852186 
            text = "..." 
        intervals [60]:
            xmin = 446.21721908852186 
            xmax = 447.79355660408595 
            text = "e não sou consultor de firmas" 
        intervals [61]:
            xmin = 447.79355660408595 
            xmax = 449.69489710652226 
            text = ".." 
        intervals [62]:
            xmin = 449.69489710652226 
            xmax = 491.9325613508339 
            text = "mas... ho-je... ah::... existe o que se chama o... Fundo de Garantia... quer dizer um depósito... que se processa por pagamentos... mensais... eu creio que... o patrão responde por uma parte... e o empregado descontado em seu salário responde por outra... mas esses depósitos vão constituído... vão constituindo um fundo... QUE mediante condições... --não posso precisar exatamente quais... porque  isso seria... ah:: uma questão de::: conhecer muito bem... a Legislação Trabalhista e eu estou afastado disso" 
        intervals [63]:
            xmin = 491.9325613508339 
            xmax = 492.938628417263 
            text = "..." 
        intervals [64]:
            xmin = 492.938628417263 
            xmax = 520.1545402272691 
            text = "MAS... Ah:: preenchidas as condições legais... o fundo de garantia... justamente assegura... ao empregado que se retira... um:: certo:: ressarcimento... não é?... que pelo menos durante algum tempo lhe permitirá... a:::... a subsistência... até que ele naturalmente obtenha... um um novo emprego" 
        intervals [65]:
            xmin = 520.1545402272691 
            xmax = 521.4020633896412 
            text = "..." 
        intervals [66]:
            xmin = 521.4020633896412 
            xmax = 523.9047653665001 
            text = "eu tenho impressão que hoje (ele) se processa dessa maneira" 
        intervals [67]:
            xmin = 523.9047653665001 
            xmax = 524.0858574384573 
            text = "..." 
        intervals [68]:
            xmin = 524.0858574384573 
            xmax = 537.5001063742576 
            text = "ANtes do Fundo de Garantia... a questão é que se resolvia... nos termos daque::la... ahn::: dispensa que eu me referi... quando respondi à:: à pergunta anterior se não estou enganado" 
        intervals [69]:
            xmin = 537.5001063742576 
            xmax = 539.3646840040395 
            text = "..." 
        intervals [70]:
            xmin = 539.3646840040395 
            xmax = 554.163151416617 
            text = "foi até muito bom é/... éh:: muito boa essa pergunta agora porque... ficou mais claro fazer agora... ficou mais clara a explicação... configurada essa essa saída do... do trabalhador não é?" 
        intervals [71]:
            xmin = 554.163151416617 
            xmax = 554.8808125906697 
            text = "..." 
        intervals [72]:
            xmin = 554.8808125906697 
            xmax = 556.491807701953 
            text = "por::: de modo próprio" 
        intervals [73]:
            xmin = 556.491807701953 
            xmax = 563.0694658202096 
            text = "..." 
        intervals [74]:
            xmin = 563.0694658202096 
            xmax = 579.5643948233429 
            text = "o acordo se processava ou melhor... acordo... haveria... se as partes... concordassem... em que::... uma delas pagaria... o patrão... e a outra receberia o empregado uma determinada importância" 
        intervals [75]:
            xmin = 579.5643948233429 
            xmax = 581.582722532857 
            text = "..." 
        intervals [76]:
            xmin = 581.582722532857 
            xmax = 601.1797486980076 
            text = "Ou então... se não houvesse acordo... a demanda... seguiria o seu trâmite... até final --em geral as causas iam terminar no... Supremo Tribunal do Trabalho--... e::... então por decisão Ju/... Judicial... o funcionário receberia" 
        intervals [77]:
            xmin = 601.1797486980076 
            xmax = 602.2699886872002 
            text = "..." 
        intervals [78]:
            xmin = 602.2699886872002 
            xmax = 606.323925637763 
            text = "e/ eu ahn::: posso citar um caso concreto meu" 
        intervals [79]:
            xmin = 606.323925637763 
            xmax = 607.7097758261291 
            text = "..." 
        intervals [80]:
            xmin = 607.7097758261291 
            xmax = 625.1321930886523 
            text = "no tempo em que eu trabalhava... no:: no curso secundário... o:::... Liceu Panamericano que era mantido pela Escola Paulista de Medicina... teve as suas atividades interrompidas... por decisão... da instituição mantenedora" 
        intervals [81]:
            xmin = 625.1321930886523 
            xmax = 627.8512965411971 
            text = "quer dizer a escola resolveu encerrar as atividades do Liceu" 
        intervals [82]:
            xmin = 627.8512965411971 
            xmax = 628.9919138229253 
            text = "..." 
        intervals [83]:
            xmin = 628.9919138229253 
            xmax = 631.4843835198208 
            text = "eu e outros colegas éramos professores do Liceu" 
        intervals [84]:
            xmin = 631.4843835198208 
            xmax = 633.6509558747933 
            text = "..." 
        intervals [85]:
            xmin = 633.6509558747933 
            xmax = 651.6695885620746 
            text = "encerradas as atividades... sob a alegação... de... força maior... motivo de força maior... impossibilidade financeira de continuar mantendo... o Liceu... é::... o:: advogado da Escola Paulista... fez a todos uma proposta" 
        intervals [86]:
            xmin = 651.6695885620746 
            xmax = 652.5852371360602 
            text = "..." 
        intervals [87]:
            xmin = 652.5852371360602 
            xmax = 654.2717023754587 
            text = "que recebêssemos cinquenta por cento" 
        intervals [88]:
            xmin = 654.2717023754587 
            xmax = 655.5214361873458 
            text = "..." 
        intervals [89]:
            xmin = 655.5214361873458 
            xmax = 674.3882555900241 
            text = "--SEM... condenar... absolutamente... a atitude dos colegas... que aceitaram esse acordo... afinal de contas é um problema individual de cada um--... eu e outros... que víamos naquilo mais uma questão de princípio... do que uma questão de ordem financeira não aceitamos" 
        intervals [90]:
            xmin = 674.3882555900241 
            xmax = 675.2500918249907 
            text = "..." 
        intervals [91]:
            xmin = 675.2500918249907 
            xmax = 692.164824047908 
            text = "não aceitamos... porque nos pareceu que não havia motivo de força maior... uma vez... que inclusive a escola... era proprieTÁria... do imóvel... ONde estava instalado o Liceu na sua última fase" 
        intervals [92]:
            xmin = 692.164824047908 
            xmax = 694.9226154930788 
            text = "..." 
        intervals [93]:
            xmin = 694.9226154930788 
            xmax = 702.8580369999784 
            text = "portanto era senhora de um patrimônio que assegurava amplamente nos parecia... o o pagamento das indenizações... então não víamos motivo" 
        intervals [94]:
            xmin = 702.8580369999784 
            xmax = 703.873599984378 
            text = "não há força maior" 
        intervals [95]:
            xmin = 703.873599984378 
