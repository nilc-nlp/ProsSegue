        intervals [1]:
            xmin = 0 
            xmax = 5.82915 
            text = "" 
        intervals [2]:
            xmin = 5.82915 
            xmax = 7.10246 
            text = "tem saído ultimamente" 
        intervals [3]:
            xmin = 7.10246 
            xmax = 7.51657 
            text = "" 
        intervals [4]:
            xmin = 7.51657 
            xmax = 8.05338 
            text = "de carro" 
        intervals [5]:
            xmin = 8.05338 
            xmax = 12.3949 
            text = "" 
        intervals [6]:
            xmin = 12.3949 
            xmax = 13.20268 
            text = "pegar assim" 
        intervals [7]:
            xmin = 13.20268 
            xmax = 14.63448 
            text = "" 
        intervals [8]:
            xmin = 14.63448 
            xmax = 15.54521 
            text = "pegar a cidade" 
        intervals [9]:
            xmin = 15.54521 
            xmax = 15.73949 
            text = "" 
        intervals [10]:
            xmin = 15.73949 
            xmax = 16.07691 
            text = "" 
        intervals [11]:
            xmin = 16.07691 
            xmax = 23.65024 
            text = "" 
        intervals [12]:
            xmin = 23.65024 
            xmax = 25.41916 
            text = "você viu se está gravando direito ou não" 
        intervals [13]:
            xmin = 25.41916 
            xmax = 25.91588 
            text = "" 
        intervals [14]:
            xmin = 25.91588 
            xmax = 26.54441 
            text = "" 
        intervals [15]:
            xmin = 26.54441 
            xmax = 27.73583 
            text = "" 
        intervals [16]:
            xmin = 27.73583 
            xmax = 29.74003 
            text = "ah o automático não indica velô não né" 
        intervals [17]:
            xmin = 29.74003 
            xmax = 46.64726 
            text = "" 
        intervals [18]:
            xmin = 46.64726 
            xmax = 46.97062 
            text = "uh" 
        intervals [19]:
            xmin = 46.97062 
            xmax = 52.71809 
            text = "" 
        intervals [20]:
            xmin = 52.71809 
            xmax = 64.33332 
            text = "eu fui quinta-feira não foi terça-feira à noite eu fui lá no né lá na celso furtado e passei ali em frente à faculdade de direito" 
        intervals [21]:
            xmin = 64.33332 
            xmax = 64.80258 
            text = "" 
        intervals [22]:
            xmin = 64.80258 
            xmax = 69.30296 
            text = "eu estava lembrando que eu ia muito lá quando eu tinha sete nove onze" 
        intervals [23]:
            xmin = 69.30296 
            xmax = 70.06566 
            text = "" 
        intervals [24]:
            xmin = 70.06566 
            xmax = 71.2507 
            text = "estava com a titia sabe" 
        intervals [25]:
            xmin = 71.2507 
            xmax = 72.48432 
            text = "" 
        intervals [26]:
            xmin = 72.48432 
            xmax = 75.39567 
            text = "e está muito pior a cidade" 
        intervals [27]:
            xmin = 75.39567 
            xmax = 80.05554 
            text = "ah o aspecto dos prédios assim é bem mais sujo tudo acinzentado né" 
        intervals [28]:
            xmin = 80.05554 
            xmax = 82.41897 
            text = "" 
        intervals [29]:
            xmin = 82.41897 
            xmax = 89.7438 
            text = "ruas mais ou menos sujas ali perto da praça da sé da praça da sé tudo esburacado por causa do metrô né" 
        intervals [30]:
            xmin = 89.7438 
            xmax = 90.60581 
            text = "" 
        intervals [31]:
            xmin = 90.60581 
            xmax = 91.25957 
            text = "achei horrível" 
        intervals [32]:
            xmin = 91.25957 
            xmax = 91.40649 
            text = "" 
        intervals [33]:
            xmin = 91.40649 
            xmax = 92.19505 
            text = "feio feio feio" 
        intervals [34]:
            xmin = 92.19505 
            xmax = 93.13679 
            text = "" 
        intervals [35]:
            xmin = 93.13679 
            xmax = 95.16225 
            text = "e toda segunda à noite eu passo ali" 
        intervals [36]:
            xmin = 95.16225 
            xmax = 96.82181 
            text = "do lado da faculdade certo" 
        intervals [37]:
            xmin = 96.82181 
            xmax = 98.16209 
            text = "" 
        intervals [38]:
            xmin = 98.16209 
            xmax = 99.30474 
            text = "é quando eu pego o carro" 
        intervals [39]:
            xmin = 99.30474 
            xmax = 100.89829 
            text = "" 
        intervals [40]:
            xmin = 100.89829 
            xmax = 103.52773 
            text = "e também é horrível o aspecto" 
        intervals [41]:
            xmin = 103.52773 
            xmax = 104.89069 
            text = "" 
        intervals [42]:
            xmin = 104.89069 
            xmax = 110.39594 
            text = "parece assim montoeira de concreto sem nenhum aspecto humano certo" 
        intervals [43]:
            xmin = 110.39594 
            xmax = 113.042 
            text = "os prédios sem estilo arquitetônico" 
        intervals [44]:
            xmin = 113.042 
            xmax = 113.48394 
            text = "" 
        intervals [45]:
            xmin = 113.48394 
            xmax = 116.06237 
            text = "ou de estilo arquitetônico tudo desencontrado" 
        intervals [46]:
            xmin = 116.06237 
            xmax = 117.80067 
            text = "não tem uma integração" 
        intervals [47]:
            xmin = 117.80067 
            xmax = 121.72599 
            text = "" 
        intervals [48]:
            xmin = 121.72599 
            xmax = 122.5863 
            text = "é parece que" 
        intervals [49]:
            xmin = 122.5863 
            xmax = 125.25406 
            text = "" 
        intervals [50]:
            xmin = 125.25406 
            xmax = 128.56966 
            text = "e parece que está ah envelhecida a cidade né" 
        intervals [51]:
            xmin = 128.56966 
            xmax = 129.6421 
            text = "" 
        intervals [52]:
            xmin = 129.6421 
            xmax = 133.37731 
            text = "ah muita construção antiga não tem muita construção nova" 
        intervals [53]:
            xmin = 133.37731 
            xmax = 149.84821 
            text = "" 
        intervals [54]:
            xmin = 149.84821 
            xmax = 150.30306 
