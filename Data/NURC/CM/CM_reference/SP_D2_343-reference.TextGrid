            text = "" 
        intervals [23]:
            xmin = 134.19048 
            xmax = 147.26034 
            text = "ó eu acho que em termos de centro por exemplo está começando a acontecer um negócio que você vê normalmente em cidade americana grande washington nova iorque que é pessoal mais classe alta ir para o subúrbio e o centro" 
        intervals [24]:
            xmin = 147.26034 
            xmax = 149.41428 
            text = "bom em washington por exemplo é gueto né" 
        intervals [25]:
            xmin = 149.41428 
            xmax = 150.30367 
            text = "em nova iorque também" 
        intervals [26]:
            xmin = 150.30367 
            xmax = 150.70087 
            text = "" 
        intervals [27]:
            xmin = 150.70087 
            xmax = 157.84917 
            text = "então a tatá estava contando outro dia né que depois das seis horas da noite você andar na cidade e o jeito dela só tem preto" 
