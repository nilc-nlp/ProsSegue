        intervals [1]:
            xmin = 0 
            xmax = 14.57858 
            text = "" 
        intervals [2]:
            xmin = 14.57858 
            xmax = 15.97382 
            text = "lembro perfeitamente" 
        intervals [3]:
            xmin = 15.97382 
            xmax = 16.54513 
            text = "" 
        intervals [4]:
            xmin = 16.54513 
            xmax = 22.56986 
            text = "bom então nós poderíamos começar dizendo que eu ia para fazenda na infância" 
        intervals [5]:
            xmin = 22.56986 
            xmax = 23.16713 
            text = "" 
        intervals [6]:
            xmin = 23.16713 
            xmax = 24.44828 
            text = "em tempo de férias" 
        intervals [7]:
            xmin = 24.44828 
            xmax = 26.43693 
            text = "" 
        intervals [8]:
            xmin = 26.43693 
            xmax = 30.49267 
            text = "a casa da fazenda ela era uma casa antiga" 
        intervals [9]:
            xmin = 30.49267 
            xmax = 31.51389 
            text = "" 
        intervals [10]:
            xmin = 31.51389 
            xmax = 32.99321 
            text = "tipo colonial brasileiro" 
        intervals [11]:
            xmin = 32.99321 
            xmax = 35.39285 
            text = "" 
        intervals [12]:
            xmin = 35.39285 
            xmax = 42.35037 
            text = "janelas largas e e mesmo as fechaduras das portas daquelas fechaduras grandes et cetera" 
        intervals [13]:
            xmin = 42.35037 
            xmax = 42.51199 
            text = "" 
        intervals [14]:
            xmin = 42.51199 
            xmax = 45.14285 
            text = "depois o chão era tudo de tábua larga" 
        intervals [15]:
            xmin = 45.14285 
            xmax = 45.25616 
            text = "" 
        intervals [16]:
            xmin = 45.25616 
            xmax = 47.52458 
            text = "e os móveis um pouco misturados" 
        intervals [17]:
            xmin = 47.52458 
            xmax = 54.62276 
            text = "quer dizer móveis antigos móveis novos e sempre precisando fazer restaurações et cetera" 
        intervals [18]:
            xmin = 54.62276 
            xmax = 58.28914 
            text = "" 
        intervals [19]:
            xmin = 58.28914 
            xmax = 60.25038 
            text = "a iluminação já era com luz elétrica" 
        intervals [20]:
            xmin = 60.25038 
            xmax = 61.61228 
            text = "" 
        intervals [21]:
            xmin = 61.61228 
            xmax = 64.7257 
            text = "isso na fazenda onde eu ia aqui em campinas" 
        intervals [22]:
            xmin = 64.7257 
            xmax = 65.78937 
            text = "" 
        intervals [23]:
            xmin = 65.78937 
            xmax = 72.38235 
            text = "agora lá para para o lado de barretos papai tinha uma faze aonde não havia ainda luz elétrica" 
        intervals [24]:
            xmin = 72.38235 
            xmax = 73.66307 
            text = "" 
        intervals [25]:
            xmin = 73.66307 
            xmax = 75.94665 
            text = "m mas é uma zona mais nova também" 
        intervals [26]:
            xmin = 75.94665 
            xmax = 77.09918 
            text = "" 
        intervals [27]:
            xmin = 77.09918 
            xmax = 79.84195 
            text = "então a própria casa era de construção recente" 
        intervals [28]:
            xmin = 79.84195 
            xmax = 80.76866 
            text = "" 
        intervals [29]:
            xmin = 80.76866 
            xmax = 81.96522 
            text = "mas não tinha luz elétrica" 
        intervals [30]:
            xmin = 81.96522 
            xmax = 84.51399 
            text = "" 
        intervals [31]:
            xmin = 84.51399 
            xmax = 87.74973 
            text = "então a a iluminação era feita com lampião" 
        intervals [32]:
            xmin = 87.74973 
            xmax = 88.93245 
            text = "" 
        intervals [33]:
            xmin = 88.93245 
            xmax = 95.21113 
            text = "lampião daqueles tipo aladim com camisinha de" 
        intervals [34]:
            xmin = 95.21113 
            xmax = 96.39435 
            text = "" 
        intervals [35]:
            xmin = 96.39435 
            xmax = 102.46225 
            text = "até não sei do que que era feita a camisinha mas era assim" 
        intervals [36]:
            xmin = 102.46225 
            xmax = 110.8639 
            text = "" 
        intervals [37]:
            xmin = 110.8639 
            xmax = 111.99104 
            text = "o terreno era" 
        intervals [38]:
            xmin = 111.99104 
            xmax = 113.14957 
            text = "" 
        intervals [39]:
            xmin = 113.14957 
            xmax = 115.80218 
            text = "aqui em campinas tem uma parte acidentada" 
        intervals [40]:
            xmin = 115.80218 
            xmax = 115.98297 
            text = "" 
        intervals [41]:
            xmin = 115.98297 
            xmax = 123.43816 
            text = "a fazenda vamos dizer tinha teria duas partes uma que é bastante acidentada e uma outra plana" 
        intervals [42]:
            xmin = 123.43816 
            xmax = 126.17357 
            text = "" 
        intervals [43]:
            xmin = 126.17357 
            xmax = 131.8077 
            text = "a a parte acidentada é uma parte vamos dizer de morraria e justamente servia para o gado" 
        intervals [44]:
            xmin = 131.8077 
            xmax = 133.24044 
            text = "" 
        intervals [45]:
            xmin = 133.24044 
            xmax = 137.67291 
            text = "enquanto que a parte plana servia para para culturas em geral" 
        intervals [46]:
            xmin = 137.67291 
            xmax = 142.12798 
            text = "" 
        intervals [47]:
            xmin = 142.12798 
            xmax = 144.0527 
            text = "bom ah até hoje se cultiva" 
        intervals [48]:
            xmin = 144.0527 
            xmax = 149.19749 
            text = "apenas eu hoje eu estou afastado do do habitat" 
        intervals [49]:
            xmin = 149.19749 
            xmax = 149.33804 
            text = "" 
        intervals [50]:
            xmin = 149.33804 
            xmax = 161.91124 
            text = "mas cultivava milho cana-de-açúcar e eh culturas que uh quer dizer não eram constantes eh culturas anuais que se renovavam" 
        intervals [51]:
            xmin = 161.91124 
            xmax = 162.5387 
            text = "" 
        intervals [52]:
            xmin = 162.5387 
            xmax = 166.60855 
            text = "por exemplo algodão e" 
        intervals [53]:
            xmin = 166.60855 
            xmax = 169.07713 
            text = "" 
        intervals [54]:
            xmin = 169.07713 
            xmax = 173.35014 
            text = "depois plantava-se também às vê às vezes eucaliptos" 
        intervals [55]:
            xmin = 173.35014 
            xmax = 173.85915 
            text = "" 
        intervals [56]:
            xmin = 173.85915 
            xmax = 176.4092 
            text = "aí aí mais tempo já não é cultura anual não é" 
        intervals [57]:
            xmin = 176.4092 
            xmax = 177.10182 
            text = "" 
        intervals [58]:
            xmin = 177.10182 
            xmax = 177.62074 
            text = "mais tempo" 
        intervals [59]:
            xmin = 177.62074 
            xmax = 181.0078 
            text = "mas também corta e e renova transforma em pasto" 
        intervals [60]:
            xmin = 181.0078 
            xmax = 184.62433 
            text = "" 
        intervals [61]:
            xmin = 184.62433 
            xmax = 190.65965 
            text = "bom e havia aliás quando quando eu ia ainda bem pequeno aí tinha café" 
        intervals [62]:
            xmin = 190.65965 
            xmax = 191.40214 
            text = "" 
        intervals [63]:
            xmin = 191.40214 
            xmax = 192.31105 
            text = "bastante café" 
        intervals [64]:
            xmin = 192.31105 
            xmax = 193.19398 
            text = "" 
        intervals [65]:
            xmin = 193.19398 
            xmax = 198.92917 
            text = "então a parte dos empregados da fazenda quer dizer o número de empregados era muito grande" 
        intervals [66]:
            xmin = 198.92917 
            xmax = 200.71995 
            text = "" 
        intervals [67]:
            xmin = 200.71995 
            xmax = 203.70635 
            text = "porque a cultura do café exigia muitos braços" 
        intervals [68]:
            xmin = 203.70635 
            xmax = 205.34058 
            text = "" 
        intervals [69]:
            xmin = 205.34058 
            xmax = 215.62845 
            text = "até no decorrer do tempo a fazenda foi diminuindo essa parte de café e em consequência também diminuiu o número de pessoas que trabalhava na fazenda" 
        intervals [70]:
            xmin = 215.62845 
            xmax = 221.09798 
            text = "" 
        intervals [71]:
