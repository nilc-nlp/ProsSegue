    item [6]:
        class = "IntervalTier" 
        name = "TB-L1-normal" 
        xmin = 0 
        xmax = 2700.88 
        intervals: size = 398 
        intervals [1]:
            xmin = 0 
            xmax = 12.21417 
            text = "" 
        intervals [2]:
            xmin = 12.21417 
            xmax = 13.37451 
            text = "conto sim não tem problema" 
        intervals [3]:
            xmin = 13.37451 
            xmax = 14.28337 
            text = "" 
        intervals [4]:
            xmin = 14.28337 
            xmax = 15.45106 
            text = "ah não tem segredo" 
        intervals [5]:
            xmin = 15.45106 
            xmax = 16.98364 
            text = "" 
        intervals [6]:
            xmin = 16.98364 
            xmax = 30.64568 
            text = "o negócio é o seguinte eu participei de um grupo de teatro formado lá no mackenzie por alunos eh alunos e alguns professores dos diversos cursos lá no mackenzie" 
        intervals [7]:
            xmin = 30.64568 
            xmax = 32.07192 
            text = "" 
        intervals [8]:
            xmin = 32.07192 
            xmax = 37.07928 
            text = "e chegamos a representar oficialmente três peças" 
        intervals [9]:
            xmin = 37.07928 
            xmax = 38.27327 
            text = "" 
        intervals [10]:
            xmin = 38.27327 
            xmax = 52.54379 
            text = "uma delas foi o massacre de manuel rubens uma peça muito bacana só que infelizmente ela foi proibida pela censura federal por ser j eh que a julgou como de cunho político" 
        intervals [11]:
            xmin = 52.54379 
            xmax = 53.13575 
            text = "" 
        intervals [12]:
            xmin = 53.13575 
            xmax = 70.08651 
            text = "então a peça se bem que não tem nada que ver com política nossa não fala nada do nosso povo ela se passa na venezuela no século entre o século quinze e o século dezesseis ou melhor do século quatorze ao século quinze perdoe não é quinze e dezesseis mesmo está certo estou antecipando a história" 
        intervals [13]:
            xmin = 70.08651 
            xmax = 70.91234 
            text = "" 
        intervals [14]:
            xmin = 70.91234 
            xmax = 81.56519 
            text = "e se bem que não tem nada que ver como acabei de dizer com a nossa vida política ela foi eh retirada pela censura federal" 
        intervals [15]:
            xmin = 81.56519 
            xmax = 82.47129 
            text = "" 
        intervals [16]:
            xmin = 82.47129 
            xmax = 87.34011 
            text = "e não foi na época foi um pouco depois nós chegamos a fazer umas quatro apresentações" 
        intervals [17]:
            xmin = 87.34011 
            xmax = 87.80015 
            text = "" 
        intervals [18]:
            xmin = 87.80015 
            xmax = 91.27061 
            text = "aí que a censura começou a dar um pouquinho em cima e agora foi oficialmente proibida" 
        intervals [19]:
            xmin = 91.27061 
            xmax = 92.47937 
            text = "" 
        intervals [20]:
            xmin = 92.47937 
            xmax = 101.43346 
            text = "depois dessa peça que foi nós apresentamos uma outra numa temporada um pouco maior não foi foram apresentações foi uma temporada" 
        intervals [21]:
            xmin = 101.43346 
            xmax = 102.08998 
            text = "" 
        intervals [22]:
            xmin = 102.08998 
            xmax = 110.305 
            text = "foi o banquete uma peça de lúcia ma benedetti uma autora nacional por sinal foi a primeira peça que o ziembinski apresentou em toda a vida dele na carreira dele" 
        intervals [23]:
            xmin = 110.305 
            xmax = 111.15378 
            text = "" 
        intervals [24]:
            xmin = 111.15378 
            xmax = 117.21541 
            text = "e praticamente peça mesmo que eu estava realizando era minha primeira também eu tive esse privilégio" 
        intervals [25]:
            xmin = 117.21541 
            xmax = 118.52056 
            text = "" 
        intervals [26]:
            xmin = 118.52056 
            xmax = 127.24 
            text = "fora uma pecinha já um uh não tão profunda quanto o massacre até um pouco mais l bem mai um pouco não bem mais leve" 
        intervals [27]:
            xmin = 127.24 
            xmax = 135.90683 
            text = "uma coisinha bacana e ah envolvia assim ah problemas de família de uma família uma família de gente humilde" 
        intervals [28]:
            xmin = 135.90683 
            xmax = 136.76804 
            text = "" 
        intervals [29]:
            xmin = 136.76804 
            xmax = 148.28 
            text = "e a terceira peça foi a que eu mais gostei na qual eu sei lá eu me entrosei realmente entende me senti bem no no papel que me foi conferido" 
        intervals [30]:
            xmin = 148.28 
            xmax = 148.55834 
            text = "" 
        intervals [31]:
            xmin = 148.55834 
            xmax = 157.48 
            text = "foi o está lá fora um inspetor de jota bê priestley que inclusive foi apresentado há pouco tempo atrás pela rede globo que avacalhou por sinal com a peça" 
        intervals [32]:
            xmin = 157.48 
            xmax = 170.55019 
            text = "modernizaram demais colocaram coisas que estavam foras mas completamente fora da do tema mudaram o enredo do do escritor quer dizer avacalharam avacalharam completamente a peça" 
        intervals [33]:
            xmin = 170.55019 
            xmax = 170.81518 
            text = "" 
        intervals [34]:
            xmin = 170.81518 
            xmax = 185.16109 
            text = "e no nosso grupo foi a peça que praticamente fez mais sucesso nós ficamos praticamente um mês em em apresentações pela comissão estadual de teatro no teatro joão caetano aqui em são paulo e foi o que eu mais gostei" 
        intervals [35]:
            xmin = 185.16109 
            xmax = 185.74627 
            text = "" 
        intervals [36]:
            xmin = 185.74627 
            xmax = 207.12633 
            text = "fora isso fizemos também um filme não com esse grupo famoso grupo lá do mackenzie também mas não um grupo de teatro foi anterior ao teatro nós fizemos um filme de longa metragem colorido inclusive na época tudo mas não com fins eh promocionais ou com fim visando algum lucro ou apresentações realmente em cinemas da da capital" 
        intervals [37]:
            xmin = 207.12633 
            xmax = 217.45036 
            text = "foi apenas uma uma realização nossa para mais para diversão um hobby um pouquinho mais caro que hobbies comuns mas foi puramente por diversão nossa" 
        intervals [38]:
            xmin = 217.45036 
            xmax = 240.76 
            text = "" 
        intervals [39]:
            xmin = 240.76 
            xmax = 258.91211 
            text = "né onde ela foi represen ah faculdade que não eh faculdade na universidade mackenzie no auditório lá no teatro rui barbosa só lá que as três peças as três não as duas primeiras o massacre e o banquete foram apresentadas lá dentro também apesar se bem que foram apresentadas fora em outros em outros locais e foram apresentadas lá dentro também" 
        intervals [40]:
            xmin = 258.91211 
            xmax = 259.96 
            text = "" 
        intervals [41]:
            xmin = 259.96 
            xmax = 271.66543 
            text = "agora eu não entendi depois eu vejo elas foram apresentadas lá dentro agora em outras faculdades não outras faculdades outras escolas não" 
        intervals [42]:
            xmin = 271.66543 
            xmax = 287.28386 
            text = "" 
        intervals [43]:
            xmin = 287.28386 
            xmax = 294.03233 
            text = "elas sempre foram bem aceitas não não teve nenhum problema de de de má aceitação por parte do público muito pelo contrário" 
        intervals [44]:
            xmin = 294.03233 
            xmax = 294.87831 
            text = "" 
        intervals [45]:
            xmin = 294.87831 
            xmax = 312.11595 
            text = "inclusive no no inspetor que foi onde eu mais me empolguei sei lá que gostei um pouco mais do papel se bem que em qualquer papel quem faz teatro qualquer papel que seja conferido ele deve saber interpretar deve gostar né na peça do deve gostar de se entrosar com o personagem" 
        intervals [46]:
            xmin = 312.11595 
            xmax = 312.2374 
            text = "" 
        intervals [47]:
