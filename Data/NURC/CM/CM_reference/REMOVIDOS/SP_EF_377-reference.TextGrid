            text = "" 
        intervals [67]:
            xmin = 251.59363 
            xmax = 269.4462 
            text = "se vocês tiverem que realizar umas faz umas continhas né e se vai comparar a realização de vocês dentro daquele tempo que vocês tiveram para fazer aquelas continhas em relação àquela escala de ansiedade" 
        intervals [68]:
            xmin = 269.4462 
            xmax = 270.32894 
            text = "" 
        intervals [69]:
            xmin = 270.32894 
            xmax = 283.00666 
            text = "então vai se verificar se aqueles altos ansiosos ou os baixos ansiosos vão realizar ah mais continhas num determinado tempo padrão certo" 
