            xmax = 34.42548 
            text = "" 
        intervals [13]:
            xmin = 34.42548 
            xmax = 35.94177 
            text = "então eu fico mais tranquila" 
        intervals [14]:
            xmin = 35.94177 
            xmax = 38.26271 
            text = "então eu estou percebendo a capacidade dele" 
        intervals [15]:
