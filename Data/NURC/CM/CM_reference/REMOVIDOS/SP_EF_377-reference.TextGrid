        intervals [17]:
            xmin = 42.48477 
            xmax = 43.2572 
            text = "no momento" 
        intervals [18]:
            xmin = 43.2572 
            xmax = 45.67166 
            text = "então por exemplo aquele teste que vocês fizeram" 
        intervals [19]:
