        intervals [75]:
            xmin = 293.60934 
            xmax = 301.28576 
            text = "então aqui no caso de sequência determinada nós iríamos verificar eh em termos de exatidão né" 
        intervals [76]:
            xmin = 301.28576 
            xmax = 312.47971 
            text = "então nós temos um padrão de exatidão e vamos verificar em que medidas os indivíduos se distanciam e se aproximam desse padrão de exatidão" 
