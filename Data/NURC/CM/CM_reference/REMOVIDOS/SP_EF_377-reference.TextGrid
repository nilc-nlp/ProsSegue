            xmax = 49.56692 
            text = "" 
        intervals [25]:
            xmin = 49.56692 
            xmax = 53.19981 
            text = "então ela mediu a realização do momento certo" 
        intervals [26]:
            xmin = 53.19981 
            xmax = 64.57515 
            text = "ao mesmo tempo em que ela mediu a realização do momento é claro que eu posso extrapolar para uma situação futura e chegar à conclusão de que certos indivíduos vão realizá-lo em cima daquilo" 
        intervals [27]:
            xmin = 64.57515 
            xmax = 70.36509 
            text = "mas as situações que ela trouxe no teste são situações reais" 
        intervals [28]:
            xmin = 70.36509 
            xmax = 71.0568 
            text = "" 
        intervals [29]:
            xmin = 71.0568 
            xmax = 71.9167 
            text = "no momento" 
        intervals [30]:
            xmin = 71.9167 
            xmax = 74.52922 
            text = "ela mediu no momento certo" 
        intervals [31]:
            xmin = 74.52922 
            xmax = 74.89998 
            text = "" 
        intervals [32]:
            xmin = 74.89998 
            xmax = 81.28695 
            text = "então o indivíduo aí no momento realizou até aquele tipo de tarefas certo" 
        intervals [33]:
            xmin = 81.28695 
            xmax = 88.60831 
            text = "então veja bem ah os testes têm como objetivo verificar a situação real desse indivíduo" 
        intervals [34]:
            xmin = 88.60831 
            xmax = 88.86744 
            text = "" 
        intervals [35]:
            xmin = 88.86744 
            xmax = 92.31669 
            text = "eu quero saber realmente do que que esse indivíduo é capaz" 
        intervals [36]:
            xmin = 92.31669 
            xmax = 92.74152 
            text = "" 
        intervals [37]:
            xmin = 92.74152 
            xmax = 99.42825 
            text = "então o teste já pressupõe que ele tem uma medida objetiva né" 
        intervals [38]:
            xmin = 99.42825 
            xmax = 106.67634 
            text = "então eh quem aqui utiliza teste já parte do princípio de que ele pode ter essa medida real" 
        intervals [39]:
            xmin = 106.67634 
            xmax = 107.76545 
            text = "" 
        intervals [40]:
            xmin = 107.76545 
            xmax = 110.67426 
            text = "é claro que isso é extremamente discutido" 
        intervals [41]:
            xmin = 110.67426 
            xmax = 111.80972 
            text = "" 
        intervals [42]:
            xmin = 111.80972 
            xmax = 123.43249 
            text = "então em psicologia há modelos que não aceitam os testes de modo algum porque é difícil você realmente ter a medida real do indivíduo" 
        intervals [43]:
            xmin = 123.43249 
            xmax = 126.87254 
            text = "a capacidade ou realização real do indivíduo" 
        intervals [44]:
            xmin = 126.87254 
            xmax = 127.7222 
            text = "" 
        intervals [45]:
            xmin = 127.7222 
            xmax = 128.2467 
            text = "por quê" 
        intervals [46]:
            xmin = 128.2467 
            xmax = 132.94679 
            text = "o indivíduo no momento pode estar com algum problema né" 
        intervals [47]:
            xmin = 132.94679 
            xmax = 133.40001 
            text = "" 
        intervals [48]:
            xmin = 133.40001 
            xmax = 157.14098 
            text = "pode estar doente pode estar impressionado pode não se sentir bem com o material do teste pode não conhecer certas questões por um motivo qualquer ele simplesmente nunca viu aquilo certo ou o teste pode estar eh falso ah dirigido mais para certos tipos de conhecimento de que ele não tem né" 
        intervals [49]:
            xmin = 157.14098 
            xmax = 158.44625 
            text = "" 
        intervals [50]:
            xmin = 158.44625 
            xmax = 175.92706 
            text = "e então a a o próprio limite do instrumento que é o teste e o limite das condições do indivíduo que são difíceis de se controlar eh não possibilitam que a gente acredite assim cem por cento nos testes percebem" 
        intervals [51]:
            xmin = 175.92706 
            xmax = 176.75569 
            text = "" 
        intervals [52]:
            xmin = 176.75569 
            xmax = 178.57536 
            text = "não dá para a gente acreditar cem por cento" 
        intervals [53]:
            xmin = 178.57536 
            xmax = 178.73746 
            text = "" 
        intervals [54]:
            xmin = 178.73746 
            xmax = 188.48129 
            text = "a gente tem uma medida recebe lá uma medida certo mas com muita cautela que a gente pode eh utilizar aquela medida certo" 
        intervals [55]:
            xmin = 188.48129 
            xmax = 194.27958 
            text = "então o que se vê e o que se faz normalmente é se aplicar assim uma bateria de testes" 
        intervals [56]:
            xmin = 194.27958 
            xmax = 194.96629 
            text = "" 
        intervals [57]:
            xmin = 194.96629 
            xmax = 205.19622 
            text = "uma porção de testes para a gente ver a constância eh e daí se tirar o traço do indivíduo realmente se persiste aquela característica ou não" 
        intervals [58]:
            xmin = 205.19622 
            xmax = 205.99415 
            text = "" 
        intervals [59]:
            xmin = 205.99415 
            xmax = 213.62824 
            text = "mas o teste isolado ou apenas um teste não dá uma aptidão muito segura" 
        intervals [60]:
            xmin = 213.62824 
            xmax = 215.23732 
            text = "" 
        intervals [61]:
            xmin = 215.23732 
            xmax = 220.16786 
            text = "bom como teste de realização nós temos testes de velocidade" 
        intervals [62]:
            xmin = 220.16786 
            xmax = 221.31121 
            text = "" 
        intervals [63]:
            xmin = 221.31121 
            xmax = 247.50686 
            text = "é para ver se o indivíduo realiza as tarefas num determinado ritmo por exemplo se ele varia ou se ele é muito lento quando ele está emocionado se ele realiza com muita rapidez se ele não está emocionado se ele realiza devagar né para se verificar inclusive eh faz usa esse teste em comparação com outro por exemplo" 
        intervals [64]:
            xmin = 247.50686 
            xmax = 247.66121 
            text = "" 
        intervals [65]:
            xmin = 247.66121 
            xmax = 250.68957 
            text = "e vocês foram comigo eu já distribuí testes" 
        intervals [66]:
