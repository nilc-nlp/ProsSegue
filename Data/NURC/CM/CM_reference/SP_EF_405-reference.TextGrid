    item [2]:
        class = "IntervalTier" 
        name = "TB-L1-normal" 
        xmin = 0 
        xmax = 1798.78528 
        intervals: size = 430 
        intervals [1]:
            xmin = 0 
            xmax = 0.05869 
            text = "" 
        intervals [2]:
            xmin = 0.05869 
            xmax = 6.01037 
            text = "então nós vamos começar pela pré-história hoje exatamente pelo período do paleolítico" 
        intervals [3]:
            xmin = 6.01037 
            xmax = 9.03405 
            text = "a arte no período paleolítico" 
        intervals [4]:
            xmin = 9.03405 
            xmax = 10.02 
            text = "" 
        intervals [5]:
            xmin = 10.02 
            xmax = 15.39081 
            text = "o paleolítico é período da pedra lascada como vocês todos sabem não é" 
        intervals [6]:
            xmin = 15.39081 
            xmax = 16.17277 
            text = "" 
        intervals [7]:
            xmin = 16.17277 
            xmax = 20.7986 
            text = "e tem uma duração de aproximadamente de seiscentos mil anos" 
        intervals [8]:
            xmin = 20.7986 
            xmax = 21.4145 
            text = "" 
        intervals [9]:
            xmin = 21.4145 
            xmax = 29.10882 
            text = "seria exatamente pegando a fase da evolução do homem enquanto o homem sapiens" 
        intervals [10]:
            xmin = 29.10882 
            xmax = 29.38639 
            text = "" 
        intervals [11]:
            xmin = 29.38639 
            xmax = 36.06649 
            text = "que já deixou de ser macaco passou a usar a inteligência a conseguir fazer coisas" 
        intervals [12]:
            xmin = 36.06649 
            xmax = 38.47988 
            text = "" 
        intervals [13]:
            xmin = 38.47988 
            xmax = 46.44949 
            text = "e como a gente vê é um período enorme frente ao que a gente conhece da história humana" 
        intervals [14]:
            xmin = 46.44949 
            xmax = 46.7656 
            text = "" 
        intervals [15]:
            xmin = 46.7656 
            xmax = 50.03817 
            text = "seiscentos mil anos é muito tempo" 
        intervals [16]:
            xmin = 50.03817 
            xmax = 52.41971 
            text = "" 
        intervals [17]:
            xmin = 52.41971 
            xmax = 57.75536 
            text = "as manifestações artísticas começaram a aparecer no paleolítico superior" 
        intervals [18]:
            xmin = 57.75536 
            xmax = 59.08743 
            text = "" 
        intervals [19]:
            xmin = 59.08743 
            xmax = 70.7821 
            text = "especificamente no período magdalense que é o último período do paleolítico e que vai abranger aproximadamente de vinte mil a doze mil antes de cristo" 
        intervals [20]:
            xmin = 70.7821 
            xmax = 72.83996 
            text = "" 
        intervals [21]:
            xmin = 72.83996 
            xmax = 78.78552 
            text = "então a gente já limitou bastante nesse período extremamente vasto de seiscentos mil anos" 
        intervals [22]:
            xmin = 78.78552 
            xmax = 79.23152 
            text = "" 
        intervals [23]:
            xmin = 79.23152 
            xmax = 95.18275 
            text = "embora de vinte mil a doze mil quer dizer praticamente oito mil anos ainda seja um período muito maior do que o que nós conhecemos historicamente" 
        intervals [24]:
            xmin = 95.18275 
            xmax = 98.49799 
            text = "que abrange por volta de cinco mil antes de cristo até hoje" 
        intervals [25]:
            xmin = 98.49799 
            xmax = 102.2227 
            text = "portanto por volta de sete mil anos certo" 
        intervals [26]:
            xmin = 102.2227 
            xmax = 102.63934 
            text = "" 
        intervals [27]:
            xmin = 102.63934 
            xmax = 122.90566 
            text = "então tudo o que a gente vai dizer a respeito desse período é baseado em pesquisas arqueológicas é baseado em pesquisas etnográficas em pesquisas no campo da arte mas uma série de coisas são suposições" 
        intervals [28]:
            xmin = 122.90566 
            xmax = 123.51345 
            text = "" 
        intervals [29]:
            xmin = 123.51345 
            xmax = 129.22301 
            text = "se nós não podemos afirmar categoricamente que as coisas se passaram assim" 
        intervals [30]:
            xmin = 129.22301 
            xmax = 129.78874 
            text = "" 
        intervals [31]:
            xmin = 129.78874 
            xmax = 143.75637 
            text = "a gente tem uma série de dados levantados especialmente pela arqueologia que a gente interpreta de um determinada forma mas com imensos buracos em branco" 
        intervals [32]:
            xmin = 143.75637 
            xmax = 144.61777 
            text = "" 
        intervals [33]:
            xmin = 144.61777 
            xmax = 152.59838 
            text = "então não é uma história ligadinha com todos os elos que a gente possa dizer olha se desenvolveu neste sentido" 
        intervals [34]:
            xmin = 152.59838 
            xmax = 153.93732 
            text = "" 
        intervals [35]:
            xmin = 153.93732 
            xmax = 164.48661 
            text = "muitas vezes a gente supõe que as coisas tenham ocorrido assim e por isso eu vou precisar que vocês se disponham a usar da imaginação" 
        intervals [36]:
            xmin = 164.48661 
            xmax = 165.55117 
            text = "" 
        intervals [37]:
            xmin = 165.55117 
            xmax = 177.04587 
            text = "para se transportar para essa época e tentar entender dentro de que contexto pôde se desenvolver uma manifestação artística" 
        intervals [38]:
            xmin = 177.04587 
            xmax = 180.3502 
            text = "" 
        intervals [39]:
            xmin = 180.3502 
            xmax = 185.64666 
            text = "então primeiro nós vamos localizar onde foram encontrados esses vestígios artísticos" 
        intervals [40]:
            xmin = 185.64666 
            xmax = 186.11485 
            text = "" 
        intervals [41]:
            xmin = 186.11485 
            xmax = 188.30113 
            text = "vou fazer um mapa aqui bastante rude" 
        intervals [42]:
            xmin = 188.30113 
            xmax = 190.88156 
            text = "" 
        intervals [43]:
            xmin = 190.88156 
            xmax = 200.6521 
            text = "isto seria a espanha e aqui a frança certo" 
        intervals [44]:
            xmin = 200.6521 
            xmax = 201.03251 
            text = "" 
        intervals [45]:
            xmin = 201.03251 
            xmax = 211.36574 
            text = "então nós vamos ter altamira que é um nome que vocês vão encontrar em muitos lugares aqui no norte da espanha" 
        intervals [46]:
            xmin = 211.36574 
            xmax = 212.27287 
            text = "" 
        intervals [47]:
            xmin = 212.27287 
            xmax = 235.53877 
            text = "e depois lascaux no sudoeste da frança e ainda aqui em toda essa região abrangendo o sudoeste da frança e sudeste da espanha com vários cavernas vários vestígios da arte pré-histórica paleolítica" 
        intervals [48]:
            xmin = 235.53877 
            xmax = 238.87863 
            text = "" 
        intervals [49]:
            xmin = 238.87863 
            xmax = 243.61261 
            text = "nos slides na próxima aula nós vamos ver basicamente altamira e lascaux" 
        intervals [50]:
            xmin = 243.61261 
            xmax = 245.32865 
            text = "" 
        intervals [51]:
            xmin = 245.32865 
            xmax = 258.16063 
            text = "bem então vamos tentar reconstruir a maneira de vida desse povo para depois poder entender como surgiu a arte e porque surgiu um determinado estilo de arte" 
        intervals [52]:
            xmin = 258.16063 
            xmax = 261.27169 
            text = "" 
        intervals [53]:
            xmin = 261.27169 
            xmax = 273.23857 
            text = "a gente vai pensar no homem do paleolítico superior como um homem que ainda não conseguiu se organizar socialmente nem politicamente" 
        intervals [54]:
            xmin = 273.23857 
            xmax = 274.31619 
            text = "" 
        intervals [55]:
            xmin = 274.31619 
            xmax = 284.88869 
            text = "eles ainda vivem em bandos ainda existe o individualismo marcado" 
        intervals [56]:
            xmin = 284.88869 
            xmax = 285.44974 
            text = "" 
        intervals [57]:
            xmin = 285.44974 
            xmax = 288.05965 
            text = "e ainda não existe o sentido de comunidade" 
        intervals [58]:
            xmin = 288.05965 
            xmax = 290.27766 
            text = "" 
        intervals [59]:
            xmin = 290.27766 
            xmax = 293.01452 
            text = "ainda é cada um por si e deus por todos" 
        intervals [60]:
            xmin = 293.01452 
            xmax = 295.09605 
            text = "" 
        intervals [61]:
            xmin = 295.09605 
            xmax = 301.89911 
            text = "quer dizer cada homem vai cuidar de seu grupo mais próximo que a gente poderia talvez denominar de grupo familiar já" 
        intervals [62]:
            xmin = 301.89911 
            xmax = 302.60778 
            text = "" 
        intervals [63]:
            xmin = 302.60778 
            xmax = 305.21474 
            text = "mas aquele grupo muito próximo dele" 
        intervals [64]:
            xmin = 305.21474 
            xmax = 306.96446 
            text = "" 
        intervals [65]:
            xmin = 306.96446 
            xmax = 309.61189 
            text = "e eles viviam basicamente da coleta" 
        intervals [66]:
            xmin = 309.61189 
            xmax = 312.16866 
            text = "eram caçadores e viviam da coleta" 
        intervals [67]:
            xmin = 312.16866 
            xmax = 313.57999 
            text = "" 
        intervals [68]:
            xmin = 313.57999 
            xmax = 316.32867 
            text = "isto levava a um tipo de vida nômade" 
        intervals [69]:
            xmin = 316.32867 
            xmax = 318.24258 
            text = "" 
        intervals [70]:
            xmin = 318.24258 
            xmax = 318.80648 
            text = "por quê" 
        intervals [71]:
            xmin = 318.80648 
            xmax = 320.7462 
            text = "" 
        intervals [72]:
            xmin = 320.7462 
            xmax = 338.94491 
            text = "porque na medida em que acabava a caça do lugar ou que em virtude da da época do ano no inverno por exemplo os animais iam hibernar outros imigravam para lugares mais quentes eles também precisavam acompanhar o a migração da caça se não eles iam ficar sem comer" 
        intervals [73]:
            xmin = 338.94491 
            xmax = 341.62272 
            text = "" 
        intervals [74]:
            xmin = 341.62272 
            xmax = 357.85924 
            text = "quanto à coleta se eles dependiam da colheita de frutos raízes que eles não plantavam que estava à disposição deles na natureza eles também tinham que obedecer o ciclo vegetativo" 
        intervals [75]:
            xmin = 357.85924 
            xmax = 358.36114 
            text = "" 
        intervals [76]:
            xmin = 358.36114 
            xmax = 363.99277 
            text = "então existe uma época para ter uma maçã outra época para ter laranja outra época para ter banana" 
        intervals [77]:
            xmin = 363.99277 
            xmax = 365.63011 
            text = "" 
        intervals [78]:
            xmin = 365.63011 
            xmax = 372.36936 
            text = "existem certas regiões onde há determinados frutos outras regiões com outros frutos" 
        intervals [79]:
            xmin = 372.36936 
            xmax = 372.9126 
            text = "" 
        intervals [80]:
            xmin = 372.9126 
            xmax = 375.99747 
            text = "então eles tinham que acompanhar este movimento também" 
        intervals [81]:
            xmin = 375.99747 
            xmax = 379.79271 
            text = "e por isso eram nômades e não se fixavam a lugar nenhum" 
        intervals [82]:
            xmin = 379.79271 
            xmax = 383.82853 
            text = "" 
        intervals [83]:
            xmin = 383.82853 
            xmax = 391.20026 
            text = "então numa vida deste tipo a preocupação principal está centrada na sobrevivência" 
        intervals [84]:
            xmin = 391.20026 
            xmax = 392.20465 
            text = "" 
        intervals [85]:
            xmin = 392.20465 
            xmax = 396.50628 
            text = "não dá tempo assim para minhocar coisas muito esotéricas" 
        intervals [86]:
            xmin = 396.50628 
            xmax = 397.18294 
            text = "" 
        intervals [87]:
            xmin = 397.18294 
            xmax = 414.46946 
            text = "de ficar pensando no sentido da vida se o rock é melhor do que o chorinho se meu deus do céu como eu vou educar meu filho para ele estar preparado para a sociedade de amanhã que está em tão rápida transformá não tem tempo para fazer isso" 
        intervals [88]:
            xmin = 414.46946 
            xmax = 415.11908 
            text = "" 
        intervals [89]:
            xmin = 415.11908 
            xmax = 421.28509 
            text = "eles precisam pegar pele para se esquentar e ter comida para comer e se defender dos outros animais" 
