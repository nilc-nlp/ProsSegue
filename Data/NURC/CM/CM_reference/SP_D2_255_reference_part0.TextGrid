			text = ""
		intervals [157]:
			xmin = 501.58358
			xmax = 503.58564
			text = "o rui deve ter andando por aí bastante de ônibus também"
		intervals [158]:
			xmin = 503.58564
			xmax = 504.30244
			text = "de navio não sei"
		intervals [159]:
			xmin = 504.30244
			xmax = 504.91134
			text = ""
		intervals [160]:
			xmin = 504.91134
			xmax = 509.85358
			text = "eh eu realmente tenho parentes no rio na guanabara então eu ando muito de ônibus daqui para o rio"
		intervals [161]:
