		intervals [164]:
			xmin = 513.49313
			xmax = 520.03668
			text = "era raro mês ou cada dois meses que eu não ia de ônibus ou de trem mesmo até a guanabara"
		intervals [165]:
			xmin = 520.03668
			xmax = 523.182
			text = "eu viajei muito naquele santa cruz aquele noturno né várias vezes"
		intervals [166]:
