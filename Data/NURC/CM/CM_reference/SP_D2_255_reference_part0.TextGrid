			text = ""
		intervals [200]:
			xmin = 648.49395
			xmax = 657.51118
			text = "mas quando me vejo privado do automóvel eu me sinto assim eh em condições de enfrentar um desafio para o qual eu não me considero preparado"
		intervals [201]:
