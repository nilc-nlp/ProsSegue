			xmin = 528.86146
			xmax = 529.15436
			text = ""
		intervals [169]:
			xmin = 529.15436
			xmax = 534.26079
			text = "quando eu estava no rio ia lá da da praça quinze até paquetá"
		intervals [170]:
			xmin = 534.26079
			xmax = 540.60916
			text = "fui muito a paquetá de naquelas barcas da cantareira que lembram aquelas barcas do mississípi né com aquelas rodas laterais"
