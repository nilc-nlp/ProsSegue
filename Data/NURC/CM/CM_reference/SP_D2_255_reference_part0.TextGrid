			text = ""
		intervals [204]:
			xmin = 661.0857
			xmax = 665.81703
			text = "é eu durante muito tempo tive que passar por este sacrifício que diz o celso de andar de ônibus"
		intervals [205]:
			xmin = 665.81703
			xmax = 669.38537
			text = "só que eu de certa forma me habituei a ler no ônibus"
		intervals [206]:
			xmin = 669.38537
