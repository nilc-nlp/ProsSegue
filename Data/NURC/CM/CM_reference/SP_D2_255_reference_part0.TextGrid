			xmin = 779.67217
			xmax = 780.0295
			text = ""
		intervals [257]:
			xmin = 780.0295
			xmax = 782.81542
			text = "e mesmo aquela passagem por estações aquela coisa sempre gostei disso"
		intervals [258]:
			xmin = 782.81542
			xmax = 783.31923
			text = ""
		intervals [259]:
			xmin = 783.31923
