		intervals [174]:
			xmin = 542.58006
			xmax = 547.92253
			text = "assim aquilo me dá uma saudade imensa do tempo que era jovem porque todas as férias eram em paquetá"
		intervals [175]:
			xmin = 547.92253
			xmax = 551.47752
			text = "então eu ia daqui para o rio de trem e lá pegava a barca"
