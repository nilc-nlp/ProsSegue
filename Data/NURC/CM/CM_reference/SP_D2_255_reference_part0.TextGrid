			xmin = 485.63977
			xmax = 486.06496
			text = ""
		intervals [155]:
			xmin = 486.06496
			xmax = 501.10641
			text = "então esta impossibilidade de me valer assim do tempo faz com que as minhas experiências de transporte pelo ônibus sejam sempre experiências marcadas por uma anggústia de chegar e por uma preocupação muito grande de me sê viver assim rapidamente desincumbido daquela tarefa"
		intervals [156]:
