			text = ""
		intervals [249]:
			xmin = 769.53464
			xmax = 771.25259
			text = "quer dizer e que ele vai naquela linha e a"
		intervals [250]:
			xmin = 771.25259
			xmax = 771.35749
			text = ""
		intervals [251]:
			xmin = 771.35749
			xmax = 772.33509
			text = "isso repousa"
		intervals [252]:
			xmin = 772.33509
			xmax = 773.51705
			text = "eu acho isso repousante"
		intervals [253]:
			xmin = 773.51705
			xmax = 777.32132
			text = "quer dizer saber que eu vou tomar um trem vou chegar daí a sete hora então tenho sete horas realmente de repouso"
		intervals [254]:
			xmin = 777.32132
