			text = "o avião é mais"
		intervals [247]:
			xmin = 761.78732
			xmax = 769.0277
			text = "mas o trem tem a vantagem sobre o avião assim de a gente ter aquela tranquilidade de saber que vai viajar durante um bom tempo"
		intervals [248]:
			xmin = 769.0277
