			xmin = 679.05635
			xmax = 679.50856
			text = ""
		intervals [210]:
			xmin = 679.50856
			xmax = 683.80928
			text = "agora ultimamente de uns dois anos a essa parte é que eu também tenho andado mais de automóvel"
