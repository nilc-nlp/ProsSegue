			text = ""
		intervals [179]:
			xmin = 556.28419
			xmax = 560.40133
			text = "agora e e as conduções aqui em são paulo por exemplo"
		intervals [180]:
			xmin = 560.40133
			xmax = 563.50311
			text = ""
		intervals [181]:
			xmin = 563.50311
			xmax = 568.96023
			text = "eu sou um indivíduo muito desprendido assim de bens materiais"
		intervals [182]:
			xmin = 568.96023
			xmax = 569.72989
			text = ""
		intervals [183]:
			xmin = 569.72989
			xmax = 574.56569
			text = "por uma questão de natureza realmente me importo muito pouco com aquilo que tenho"
		intervals [184]:
			xmin = 574.56569
			xmax = 575.49762
			text = ""
		intervals [185]:
			xmin = 575.49762
			xmax = 585.98261
			text = "mas eu considero o automóvel face às condições do transporte urbano como sendo um dos bens indispensáveis à minha vida"
		intervals [186]:
			xmin = 585.98261
			xmax = 587.49311
			text = "não apenas pelo fator tempo"
		intervals [187]:
			xmin = 587.49311
			xmax = 588.17146
			text = ""
		intervals [188]:
			xmin = 588.17146
			xmax = 600.35419
			text = "mas se algumas vezes eu me senti identificado como um animal foi quando tive que enfrentar ônibus e às vezes até mesmo a luta pela obtenção do táxi"
		intervals [189]:
			xmin = 600.35419
			xmax = 600.88504
			text = ""
		intervals [190]:
			xmin = 600.88504
			xmax = 614.77327
			text = "eu sou um indivíduo que não me envergonho em determinadas circunstâncias de ter que me humilhar para obter algumas coisas ainda que esta humilhação seja em termos assim marcados por uma certa condição de nobreza"
		intervals [191]:
			xmin = 614.77327
			xmax = 615.17987
			text = ""
		intervals [192]:
			xmin = 615.17987
			xmax = 624.3959
			text = "mas acho que apanhar um táxi em são paulo ou enfrentar as filas de ônibus corresponde a uma humilhação para a qual eu eh psicologicamente não me sinto preparado"
		intervals [193]:
			xmin = 624.3959
			xmax = 624.80662
			text = ""
		intervals [194]:
			xmin = 624.80662
			xmax = 631.77327
			text = "então acho detestável sob todos os aspectos e as experiências que tive foram sempre eh muito desagradáveis"
		intervals [195]:
			xmin = 631.77327
			xmax = 636.30754
			text = "é evidente que a as experiências agradáveis não foram registradas"
		intervals [196]:
			xmin = 636.30754
			xmax = 645.0607
			text = "eu não não me lembro e nem seria o caso de lembrar de uma confortável viagem por um ônibus urbano ou por um motorista de táxi assim extremamente solícito educado"
		intervals [197]:
			xmin = 645.0607
