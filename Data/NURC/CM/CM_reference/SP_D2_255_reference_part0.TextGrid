			text = ""
		intervals [263]:
			xmin = 788.05663
			xmax = 791.98782
			text = "é acho que até que enfim nós encontramos um ponto em comum"
		intervals [264]:
			xmin = 791.98782
			xmax = 794.49224
			text = "realmente eu também sou um grande admirador do trem"
		intervals [265]:
			xmin = 794.49224
			xmax = 804.1368
			text = "é claro que eh enfrentei anos atrás ah algumas viagens de trem em condições que se identificavam com aquelas que descrevi de ônibus"
		intervals [266]:
			xmin = 804.1368
			xmax = 804.42742
			text = ""
		intervals [267]:
			xmin = 804.42742
			xmax = 813.43558
			text = "inclusive quando servi o exército o trem militar nos levava eh oferecia condições de desconforto incríveis mesmo quando comparado com o transporte de animais"
		intervals [268]:
			xmin = 813.43558
			xmax = 813.84944
			text = ""
		intervals [269]:
			xmin = 813.84944
			xmax = 817.97313
			text = "mas atualmente quando possível eh eu sempre faço esta opção"
		intervals [270]:
			xmin = 817.97313
			xmax = 818.45345
			text = ""
		intervals [271]:
			xmin = 818.45345
			xmax = 834.20689
			text = "e acho integralmente válido isso que o rui falou em termos de descanso em termos de serenidade pela leitura e principalmente pelo bucólico que representa aquela sucessão de paisagens aquelas paradas e aquelas estações que trazem sempre reminiscências assim de infância"
		intervals [272]:
			xmin = 834.20689
			xmax = 848.13241
			text = "moro no brooklin eh eh a caminho de santo amaro anos atrás santo amaro se ligava à cidade pelo bonde e as os pontos de parada identificavam o que hoje significam as várias estações"
		intervals [273]:
			xmin = 848.13241
			xmax = 848.48047
			text = ""
		intervals [274]:
			xmin = 848.48047
			xmax = 853.62808
			text = "de maneira que o trem tem também para mim aquele sabor de reminiscência e quase aquele gosto assim de infância"
		intervals [275]:
			xmin = 853.62808
			xmax = 853.98883
			text = ""
		intervals [276]:
			xmin = 853.98883
			xmax = 857.52857
			text = "nesse aspecto eu quando posso escolher não vacilo"
		intervals [277]:
			xmin = 857.52857
			xmax = 857.8998
			text = ""
		intervals [278]:
			xmin = 857.8998
			xmax = 859.58269
			text = "o trem realmente é muito agradável"
		intervals [279]:
			xmin = 859.58269
			xmax = 861.2381
			text = "mas muito raramente posso escolher"
		intervals [280]:
			xmin = 861.2381
			xmax = 862.47163
			text = ""
		intervals [281]:
			xmin = 862.47163
			xmax = 868.70332
			text = "eh o senhor teria alguma ou teriam queriam me dizer algumas particularidades ainda referente a transporte"
		intervals [282]:
			xmin = 868.70332
			xmax = 869.16607
			text = ""
		intervals [283]:
			xmin = 869.16607
			xmax = 870.91139
			text = "talvez não mencionados aqui na"
		intervals [284]:
			xmin = 870.91139
			xmax = 871.80437
			text = ""
		intervals [285]:
			xmin = 871.80437
			xmax = 873.39976
			text = "não particularidade especificamente não"
		intervals [286]:
			xmin = 873.39976
			xmax = 881.05706
			text = "a última viagem de trem que fiz como que a desmentir esta minha impressão eh foi uma viagem marcada por um um incidente muito sério"
		intervals [287]:
			xmin = 881.05706
			xmax = 892.57226
			text = "eu deveria fazer a inauguração de uma sucursal da editora do brasil em são josé do rio preto tomei o trem e o trem um pouco antes de araraquara parou por falta de energia"
		intervals [288]:
			xmin = 892.57226
			xmax = 893.07405
			text = ""
		intervals [289]:
			xmin = 893.07405
			xmax = 912.43182
			text = "como o tempo de que eu dispunha era muito inferior ao tempo necessário para o trem chegar face ao atraso eu tive que descer no meio do caminho andar um quilômetro e meio a pé correndo com mala depois tentar subornar um motorista para me levar até são josé do rio preto de maneira que foi uma experiência muito marcante"
		intervals [290]:
			xmin = 912.43182
			xmax = 919.25437
			text = "mas nem por isso eu posso generalizar e acusar de negativas as viagens de trem feita nessas circunstâncias"
		intervals [291]:
			xmin = 919.25437
			xmax = 919.7157
			text = ""
		intervals [292]:
			xmin = 919.7157
			xmax = 922.84919
			text = "não sei se o rui teria alguma outra particularidade relativa a transportes"
		intervals [293]:
			xmin = 922.84919
			xmax = 924.51915
			text = ""
		intervals [294]:
			xmin = 924.51915
			xmax = 934.61491
			text = "ah apenas eu gostaria de de de de situar o seguinte eu tenho a impressão que o homem moderno hoje perdeu muito assim o sabor de aproveitar uma viagem entende"
		intervals [295]:
			xmin = 934.61491
			xmax = 948.69858
			text = "eu acho que quando a gente pode pegar uma bicicleta por exemplo e sair andando de bicicleta ou um cavalo entende ou mesmo a pé entende tudo isso dá um sabor de paisagem um sabor assim humano muito maior do que esses transportes de alta velocidade"
		intervals [296]:
			xmin = 948.69858
			xmax = 950.72603
			text = "mesmo o o trem numa certa situação quer dizer"
		intervals [297]:
			xmin = 950.72603
			xmax = 951.24671
			text = ""
		intervals [298]:
			xmin = 951.24671
			xmax = 960.8357
			text = "então eu tenho a impressão como esse desumaniza um pouco por perder assim esse tipo de de viagem mais lenta mais saborosa mais aproveitada entende"
		intervals [299]:
			xmin = 960.8357
			xmax = 962.89488
			text = ""
		intervals [300]:
